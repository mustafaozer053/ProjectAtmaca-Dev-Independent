@page "/roster"
@rendermode InteractiveServer
@using System.Linq
@using ProjectAtmaca.Web.Services
@inject SeasonTeamsApiClient Api

<PageTitle>Sezon Takım Kadrosu</PageTitle>

@if (isLoading)
{
    <div class="roster-page"><p class="muted">Kadro verileri yükleniyor...</p></div>
}
else if (errorMessage is not null)
{
    <div class="roster-page">
        <p class="muted">@errorMessage</p>
        <button class="btn btn-primary" @onclick="ReloadAsync">Tekrar dene</button>
    </div>
}
else if (selectedTeam is null)
{
    <div class="roster-page">
        <div class="empty-state">
            <h1>Henüz sezon takımı yok</h1>
            <p class="muted">Kadro yönetimine başlamak için ilk sezon takımınızı oluşturun.</p>
            <button class="btn btn-primary" @onclick="OpenCreateTeam">+ Sezon takımı oluştur</button>
        </div>
    </div>
}
else
{
    <div class="roster-page">
        <header class="roster-header">
            <div>
                <div class="eyebrow">SEZON TAKIMI · KADRO YÖNETİMİ</div>
                <h1>@selectedTeam.Name</h1>
                <p class="muted">Project Atmaca Akademi</p>
            </div>
            <div class="header-actions">
                @if (teams.Count > 1)
                {
                    <select class="form-input" style="width:auto" value="@selectedTeam.Id" @onchange="OnTeamChangedAsync">
                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    </select>
                }
                <button class="status-pill @(selectedTeam.IsActive ? "active" : "passive") status-button" @onclick="ToggleTeamStatusAsync">
                    <span></span> @(selectedTeam.IsActive ? "Aktif takım" : "Pasif takım")
                </button>
                <button class="btn btn-light" @onclick="OpenCreateTeam">+ Yeni takım</button>
                <button class="btn btn-primary" @onclick="OpenAddMember">+ Kadroya üye ekle</button>
            </div>
        </header>

        <section class="summary-grid" aria-label="Kadro özeti">
            <SummaryCard Label="Toplam üye" Value="@Members.Count" Detail="Bu sezon kayıtlı" Tone="blue" />
            <SummaryCard Label="Aktif üyelik" Value="@Members.Count(m => m.IsActive)" Detail="Bugün geçerli" Tone="green" />
            <SummaryCard Label="Sporcu" Value="@Members.Count(m => m.Classifications.Contains("Sporcu", StringComparer.OrdinalIgnoreCase))" Detail="Aktif sınıflandırma" Tone="purple" />
            <SummaryCard Label="Teknik ekip" Value="@Members.Count(m => m.Classifications.Contains("Teknik Ekip", StringComparer.OrdinalIgnoreCase))" Detail="Aktif sınıflandırma" Tone="orange" />
        </section>

        <div class="toolbar">
            <div class="section-tabs" role="tablist" aria-label="Kadro bölümü">
                <button class="tab @(selectedSection == "Tümü" ? "selected" : "")" @onclick='@(() => selectedSection = "Tümü")'>Tümü <b>@Members.Count</b></button>
                <button class="tab @(selectedSection == "Sporcu" ? "selected" : "")" @onclick='@(() => selectedSection = "Sporcu")'>Sporcular <b>@Members.Count(m => m.Classifications.Contains("Sporcu", StringComparer.OrdinalIgnoreCase))</b></button>
                <button class="tab @(selectedSection == "Teknik Ekip" ? "selected" : "")" @onclick='@(() => selectedSection = "Teknik Ekip")'>Teknik ekip <b>@Members.Count(m => m.Classifications.Contains("Teknik Ekip", StringComparer.OrdinalIgnoreCase))</b></button>
                <button class="tab @(selectedSection == "Sınıflandırılmamış" ? "selected" : "")" @onclick='@(() => selectedSection = "Sınıflandırılmamış")'>Sınıflandırılmamış <b>@Members.Count(m => m.Classifications.Count == 0)</b></button>
            </div>
            <label class="search-box">
                <span aria-hidden="true">⌕</span>
                <input @bind="searchTerm" placeholder="Kadroyu ara..." aria-label="Kadroyu ara" />
            </label>
        </div>

        <section class="member-card">
            <div class="card-heading">
                <div><h2>@selectedSection</h2><span>@FilteredMembers.Count() kayıt gösteriliyor</span></div>
                <button class="btn btn-light" @onclick="OpenAddMember">Üye işlemleri <span>⌄</span></button>
            </div>
            <div class="table-wrap">
                @if (!FilteredMembers.Any())
                {
                    <div class="empty-search">Bu bölümde gösterilecek üye bulunmuyor.</div>
                }
                else
                {
                    <table class="member-table">
                        <thead><tr><th>ÜYE</th><th>GÖREV / ÜNVAN / ROL</th><th>ÜYELİK DÖNEMİ</th><th>DURUM</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var member in FilteredMembers)
                            {
                                <tr>
                                    <td><div class="member-name"><div class="avatar @member.AvatarColor">@member.Initials</div><div><strong>@member.Name</strong><small>@member.CardCode</small></div></div></td>
                                    <td><div class="assignment-list">@foreach (var assignment in member.Assignments) { <span class="assignment-tag @assignment.Kind">@assignment.Text</span> }</div></td>
                                    <td><span class="period">@member.Period</span></td>
                                    <td><span class="status-pill @(member.IsActive ? "active" : "passive")"><span></span>@MemberStatus(member)</span></td>
                                    <td><button class="more-button" aria-label="@member.Name detayları" @onclick="() => OpenMemberDetails(member)">•••</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>

        @if (selectedMember is not null)
        {
            <div class="detail-overlay" @onclick="CloseDetails">
                <aside class="detail-panel" @onclick:stopPropagation>
                    <button class="close-button" @onclick="CloseDetails">×</button>
                    <div class="detail-profile"><div class="avatar large @selectedMember.AvatarColor">@selectedMember.Initials</div><div><h2>@selectedMember.Name</h2><p>@selectedMember.CardCode</p></div></div>
                    <div class="detail-section">
                        <h3>Bu kadrodaki atamalar</h3>
                        @foreach (var assignment in selectedMember.Assignments)
                        {
                            <div class="detail-assignment">
                                <span class="assignment-tag @assignment.Kind">@assignment.Text</span>
                                <small>@assignment.Period</small>
                                @if (assignment.IsActive)
                                {
                                    <button class="assignment-end-button" @onclick="() => EndAssignmentAsync(assignment)">Sonlandır</button>
                                }
                            </div>
                        }
                        @if (assignmentError is not null)
                        {
                            <div class="error-banner">@assignmentError</div>
                        }
                        <div class="assignment-form">
                            <select class="form-input" @bind="assignmentScope">
                                <option value="SeasonTeam">Sezon takımı görevi</option>
                                <option value="Organization">Kulüp geneli görevi</option>
                            </select>
                            @if (assignmentScope == "SeasonTeam")
                            {
                                <select class="form-input" @bind="assignmentKind">
                                    <option value="Classification">Sınıflandırma</option>
                                    <option value="Role">Rol</option>
                                    <option value="Duty">Görev</option>
                                    <option value="Title">Ünvan</option>
                                </select>
                            }
                            else
                            {
                                <p class="muted">Bu görev sezonlardan bağımsızdır; görev bitiş tarihini ayrıca girerek sonlandırabilirsiniz.</p>
                                <label class="form-label">Görev başlangıç tarihi
                                    <input type="date" class="form-input" @bind="organizationDutyStartDate" />
                                </label>
                            }
                            <input class="form-input" @bind="assignmentName" list="roster-duty-titles"
                                   placeholder="@(assignmentScope == "SeasonTeam" && assignmentKind == "Classification" ? "Sınıflandırma seçin veya yazın" : "Görev adını yazın veya seçin")" />
                            <button class="btn btn-light" @onclick="AddAssignmentAsync" disabled="@isAddingAssignment">
                                @(isAddingAssignment ? "Ekleniyor..." : "Atama ekle")
                            </button>
                        </div>
                    </div>
                    @if (selectedTeam is not null)
                    {
                        <div class="detail-section">
                            <h3>Kulüp genelindeki görevler</h3>
                            <p class="muted">Sezondan bağımsız görevlendirmeler; ör. Başkan veya Muhasebe Müdürü.</p>
                            @if (isLoadingOrganizationDuties)
                            {
                                <p class="muted">Kurum görevleri yükleniyor...</p>
                            }
                            else if (organizationDutyAssignments.Count == 0)
                            {
                                <p class="muted">Bu kişiye bu kulüpte henüz görev atanmamış.</p>
                            }
                            @foreach (var duty in organizationDutyAssignments)
                            {
                                <div class="detail-assignment">
                                    <span class="assignment-tag duty">@duty.Title</span>
                                    <small>@FormatOrganizationDutyPeriod(duty)</small>
                                    @if (!duty.EndDate.HasValue && duty.StartDate.Date <= DateTime.Today)
                                    {
                                        <button class="assignment-end-button" @onclick="() => EndOrganizationDutyAsync(duty)" disabled="@isAddingAssignment">Sonlandır</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="detail-section">
                        <h3>Üyelik dönemi</h3>
                        <p class="detail-period">@selectedMember.Period</p>
                        <span class="status-pill @(selectedMember.IsActive ? "active" : "passive")"><span></span>@MembershipStatus(selectedMember)</span>
                        @if (selectedMember.IsActive && selectedMember.EndDate is null)
                        {
                            @if (!showMembershipEndForm)
                            {
                                <button class="membership-end-button" @onclick="OpenMembershipEndForm">
                                    Üyeliği sonlandır
                                </button>
                            }
                            else
                            {
                                <label class="membership-end-date">
                                    Üyeliğin son günü
                                    <input type="date" @bind="membershipEndDate" />
                                </label>
                                <button class="membership-end-button" @onclick="EndMembershipAsync" disabled="@isEndingMembership">
                                    @(isEndingMembership ? "Sonlandırılıyor..." : "Seçilen tarihte sonlandır")
                                </button>
                                <button class="text-button" @onclick="() => showMembershipEndForm = false" disabled="@isEndingMembership">Vazgeç</button>
                            }
                        }
                        @if (assignmentError is not null)
                        {
                            <div class="error-banner">@assignmentError</div>
                        }
                    </div>
                    <button class="btn btn-primary full-width" @onclick="CloseDetails">Üyelik detayını aç</button>
                </aside>
            </div>
        }

        @if (showAddMember)
        {
            <div class="detail-overlay" @onclick="CloseAddMember">
                <aside class="detail-panel add-panel" @onclick:stopPropagation>
                    <button class="close-button" @onclick="CloseAddMember">×</button>
                    <h2>Kadroya üye ekle</h2>
                    <p class="muted">İsim veya AtmacaCard numarasıyla arayın ve seçtiğiniz kartı bu takıma ekleyin.</p>
                    <div class="search-box add-member-search">
                        <input @bind="cardSearchTerm" placeholder="Ör. Ahmet veya ATM-000003" />
                        <button type="button" class="btn btn-light" @onclick="SearchCardsAsync" disabled="@isSearchingCards">Ara</button>
                    </div>
                    @if (addMemberError is not null)
                    {
                        <div class="error-banner">@addMemberError</div>
                    }
                    @if (cardSearchResults.Count > 0)
                    {
                        <div class="card-search-results">
                            @foreach (var card in cardSearchResults)
                            {
                                <button type="button" class="card-search-result @(selectedCard?.AtmacaCardId == card.AtmacaCardId ? "selected" : "")" @onclick="() => selectedCard = card">
                                    <span><strong>@card.FullName</strong><small>@card.CardNumber</small></span>
                                    <span>@(selectedCard?.AtmacaCardId == card.AtmacaCardId ? "Seçildi" : "Seç")</span>
                                </button>
                            }

                        </div>
                    }
                    else if (hasSearchedCards)
                    {
                        <div class="empty-search">Eşleşen AtmacaCard bulunamadı.</div>
                    }
                    @if (selectedCard is not null)
                    {
                        <div class="selected-card">
                            <strong>@selectedCard.FullName</strong>
                            <span>@selectedCard.CardNumber</span>
                        </div>
                        <label class="form-label">Kadroya katılım tarihi
                            <input type="date" class="form-input" @bind="membershipStartDate" />
                        </label>
                        <label class="form-label">Kadrodan ayrılma tarihi (isteğe bağlı)
                            <input type="date" class="form-input" @bind="membershipEndDateInput" />
                        </label>
                        @if (HasOverlappingMembership)
                        {
                            <div class="error-banner">Bu kart, seçilen tarihlerde zaten bu takımın kadrosunda görünüyor.</div>
                        }
                        <button class="btn btn-primary full-width" @onclick="AddSelectedMemberAsync" disabled="@(isAddingMember || HasOverlappingMembership)">
                            @(isAddingMember ? "Ekleniyor..." : HasMembershipHistory ? "Yeni üyelik dönemi aç" : "Bu kartı kadroya ekle")
                        </button>
                    }
                </aside>
            </div>
        }
    </div>
}

@if (showCreateTeam)
{
    <div class="detail-overlay" @onclick="CloseCreateTeam">
        <aside class="detail-panel add-panel" @onclick:stopPropagation>
            <button class="close-button" @onclick="CloseCreateTeam">×</button>
            <h2>Sezon takımı oluştur</h2>
            <p class="muted">Takımın bağlı olduğu sezon, organizasyon ve yaş grubunu seçin.</p>
            <label class="form-label">Takım adı
                <input class="form-input" @bind="createTeamName" placeholder="Ör. U16 Akademi" />
            </label>
            <label class="form-label">Sezon
                <select class="form-input" @bind="createSeasonId">
                    <option value="">Sezon seçin</option>
                    @foreach (var item in seasons)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </label>
            <label class="form-label">Organizasyon
                <select class="form-input" @bind="createOrganizationId">
                    <option value="">Organizasyon seçin</option>
                    @foreach (var item in organizations)
                    {
                        <option value="@item.Id">@OrganizationDisplayName(item)</option>
                    }
                </select>
            </label>
            <label class="form-label">Yaş grubu
                <select class="form-input" @bind="createAgeGroupId">
                    <option value="">Yaş grubu seçin</option>
                    @foreach (var item in ageGroups)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </label>
            @if (teamManagementError is not null)
            {
                <div class="error-banner">@teamManagementError</div>
            }
            <button class="btn btn-primary full-width" @onclick="CreateTeamAsync" disabled="@isCreatingTeam">
                @(isCreatingTeam ? "Oluşturuluyor..." : "Sezon takımını oluştur")
            </button>
        </aside>
    </div>
}

<datalist id="roster-duty-titles">
    @foreach (var title in AssignmentNameSuggestions)
    {
        <option value="@title"></option>
    }
</datalist>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private IReadOnlyList<SeasonTeamResponse> teams = [];
    private IReadOnlyList<CatalogItemResponse> seasons = [];
    private IReadOnlyList<CatalogItemResponse> organizations = [];
    private IReadOnlyList<CatalogItemResponse> ageGroups = [];
    private SeasonTeamResponse? selectedTeam;
    private IReadOnlyList<Member> Members = [];

    private string selectedSection = "Tümü";
    private string searchTerm = string.Empty;
    private bool showAddMember;
    private Member? selectedMember;
    private string cardSearchTerm = string.Empty;
    private IReadOnlyList<AtmacaCardSummary> cardSearchResults = [];
    private AtmacaCardSummary? selectedCard;
    private bool isSearchingCards;
    private bool isAddingMember;
    private bool hasSearchedCards;
    private string? addMemberError;
    private bool showCreateTeam;
    private bool isCreatingTeam;
    private string createTeamName = string.Empty;
    private string createSeasonId = string.Empty;
    private string createOrganizationId = string.Empty;
    private string createAgeGroupId = string.Empty;
    private string? teamManagementError;
    private string assignmentKind = "Classification";
    private string assignmentScope = "SeasonTeam";
    private DateTime membershipStartDate = DateTime.Today;
    private DateTime? membershipEndDateInput;
    private static readonly IReadOnlyList<string> ClassificationSuggestions =
        ["Sporcu", "Teknik Ekip"];
    private IReadOnlyList<string> AssignmentNameSuggestions =>
        assignmentScope == "SeasonTeam" && assignmentKind == "Classification"
            ? ClassificationSuggestions
            : DutyTitleSuggestions;
    private string assignmentName = string.Empty;
    private DateTime organizationDutyStartDate = DateTime.Today;
    private IReadOnlyList<OrganizationDutyAssignmentResponse> organizationDutyAssignments = [];
    private bool isLoadingOrganizationDuties;
    private static IReadOnlyList<string> DutyTitleSuggestions =>
        OrganizationDutyTitleSuggestions.Values;
    private bool isAddingAssignment;
    private bool isEndingMembership;
    private bool showMembershipEndForm;
    private DateOnly membershipEndDate = DateOnly.FromDateTime(DateTime.Today);
    private string? assignmentError;

    private IEnumerable<Member> FilteredMembers => Members.Where(m =>
        (selectedSection == "Tümü" ||
         (selectedSection == "Sınıflandırılmamış"
             ? m.Classifications.Count == 0
             : m.Classifications.Contains(selectedSection, StringComparer.OrdinalIgnoreCase))) &&
        (string.IsNullOrWhiteSpace(searchTerm) || m.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || m.CardCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private bool HasMembershipHistory =>
        selectedCard is not null &&
        Members.Any(member => member.AtmacaCardId == selectedCard.AtmacaCardId);

    private bool HasOverlappingMembership
    {
        get
        {
            if (selectedCard is null)
                return false;

            DateTime requestedEnd = membershipEndDateInput?.Date ?? DateTime.MaxValue.Date;
            return Members.Any(member =>
                member.AtmacaCardId == selectedCard.AtmacaCardId &&
                membershipStartDate.Date <= (member.EndDate?.Date ?? DateTime.MaxValue.Date) &&
                member.StartDate.Date <= requestedEnd);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            teams = await Api.GetSeasonTeamsAsync();
            selectedTeam = teams.FirstOrDefault();

            if (selectedTeam is not null)
            {
                await LoadRosterAsync(selectedTeam.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Kadro verileri yüklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnTeamChangedAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var teamId))
        {
            selectedTeam = teams.FirstOrDefault(t => t.Id == teamId);
            selectedSection = "Tümü";
            searchTerm = string.Empty;
            selectedMember = null;

            if (selectedTeam is not null)
            {
                await LoadRosterAsync(selectedTeam.Id);
            }
        }
    }

    private async Task LoadRosterAsync(Guid seasonTeamId)
    {
        var roster = await Api.GetRosterViewAsync(seasonTeamId);
        Members = roster is null
            ? []
            : roster.Groups
                .SelectMany(group => group.Memberships)
                .Concat(roster.UnclassifiedMemberships)
                .DistinctBy(membership => membership.Id)
                .Select(ToMember)
                .OrderBy(m => m.Name)
                .ToList();
    }

    private static Member ToMember(SeasonTeamMembershipResponse membership)
    {
        var name = !string.IsNullOrWhiteSpace(membership.AtmacaCardDisplayName)
            ? membership.AtmacaCardDisplayName!
            : "İsimsiz kart";
        var cardCode = membership.AtmacaCardNumber ?? "—";
        var period = membership.EndDate is null
            ? $"{membership.StartDate:dd.MM.yyyy} - devam ediyor"
            : $"{membership.StartDate:dd.MM.yyyy} - {membership.EndDate:dd.MM.yyyy}";

        var assignments = membership.Assignments
            .Where(a => a.IsActive)
            .Select(a => new Assignment(
                a.Id,
                ToTagCssClass(a.Kind, a.DisplayNameSnapshot),
                a.DisplayNameSnapshot,
                FormatAssignmentPeriod(a),
                a.IsActive))
            .ToList();

        var classifications = membership.Assignments
            .Where(assignment =>
                assignment.Kind.Equals("Classification", StringComparison.OrdinalIgnoreCase) &&
                assignment.IsActive)
            .Select(assignment => assignment.DisplayNameSnapshot)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new Member(
            membership.Id,
            name,
            cardCode,
            ToInitials(name),
            ToAvatarColor(name),
            classifications,
            membership.StartDate,
            period,
            membership.IsActive,
            membership.EndDate,
            assignments,
            membership.AtmacaCardId);
    }

    private static string MemberStatus(Member member) =>
        member.IsActive && member.EndDate.HasValue ? "Son gün" :
        member.IsActive ? "Aktif" : "Pasif";

    private static string MembershipStatus(Member member) =>
        member.IsActive && member.EndDate.HasValue
            ? "Son gün (gün sonunda pasif olur)"
            : member.IsActive ? "Aktif üyelik" : "Sonlandırılmış üyelik";

    private static string ToTagCssClass(string kind, string label)
    {
        if (string.Equals(kind, "Classification", StringComparison.OrdinalIgnoreCase))
        {
            return string.Equals(label, "Sporcu", StringComparison.OrdinalIgnoreCase) ? "player" : "duty";
        }

        return kind.ToLowerInvariant();
    }

    private static string FormatAssignmentPeriod(SeasonTeamMembershipAssignmentResponse assignment)
    {
        return assignment.EndDate is null
            ? $"{assignment.StartDate:dd.MM.yyyy} - devam ediyor"
            : $"{assignment.StartDate:dd.MM.yyyy} - {assignment.EndDate:dd.MM.yyyy}";
    }

    private static string ToInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
        };
    }

    private static readonly string[] AvatarPalette = ["blue", "pink", "green", "orange", "purple", "gray"];

    private static string ToAvatarColor(string name)
    {
        var index = Math.Abs(name.GetHashCode()) % AvatarPalette.Length;
        return AvatarPalette[index];
    }

    private void OpenAddMember()
    {
        showAddMember = true;
        cardSearchTerm = string.Empty;
        cardSearchResults = [];
        selectedCard = null;
        hasSearchedCards = false;
        addMemberError = null;
        membershipStartDate = DateTime.Today;
        membershipEndDateInput = null;
    }

    private void CloseAddMember() => showAddMember = false;

    private async Task OpenCreateTeam()
    {
        seasons = await Api.GetCatalogAsync("seasons");
        organizations = await Api.GetCatalogAsync("organizations");
        ageGroups = await Api.GetCatalogAsync("age-groups");
        showCreateTeam = true;
        teamManagementError = null;
        createTeamName = string.Empty;
        createSeasonId = selectedTeam?.SeasonId.ToString("D") ?? string.Empty;
        createOrganizationId = selectedTeam?.OrganizationId.ToString("D") ?? string.Empty;
        createAgeGroupId = selectedTeam?.AgeGroupId.ToString("D") ?? string.Empty;
    }

    private void CloseCreateTeam() => showCreateTeam = false;

    private async Task CreateTeamAsync()
    {
        if (!Guid.TryParse(createSeasonId, out var seasonId)
            || !Guid.TryParse(createOrganizationId, out var organizationId)
            || !Guid.TryParse(createAgeGroupId, out var ageGroupId)
            || string.IsNullOrWhiteSpace(createTeamName))
        {
            teamManagementError = "Takım adı ve üç geçerli GUID alanı zorunludur.";
            return;
        }

        isCreatingTeam = true;
        teamManagementError = null;
        try
        {
            var teamId = await Api.CreateSeasonTeamAsync(
                seasonId,
                organizationId,
                ageGroupId,
                createTeamName.Trim());

            if (teamId is null)
            {
                teamManagementError = "Sezon takımı oluşturulamadı.";
                return;
            }

            showCreateTeam = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            teamManagementError = $"Takım oluşturulurken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isCreatingTeam = false;
        }
    }

    private async Task ToggleTeamStatusAsync()
    {
        if (selectedTeam is null)
            return;

        teamManagementError = null;
        try
        {
            var changed = await Api.ChangeTeamStatusAsync(
                selectedTeam.Id,
                !selectedTeam.IsActive);
            if (!changed)
            {
                teamManagementError = "Takım durumu değiştirilemedi.";
                return;
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            teamManagementError = $"Takım durumu değiştirilirken bir sorun oluştu: {ex.Message}";
        }
    }

    private async Task SearchCardsAsync()
    {
        if (cardSearchTerm.Trim().Length < 2)
        {
            addMemberError = "Arama için en az 2 karakter girin.";
            cardSearchResults = [];
            hasSearchedCards = false;
            return;
        }

        isSearchingCards = true;
        addMemberError = null;
        selectedCard = null;

        try
        {
            cardSearchResults = await Api.SearchCardsAsync(cardSearchTerm);
            hasSearchedCards = true;
        }
        catch (Exception ex)
        {
            addMemberError = $"Kartlar aranırken bir sorun oluştu: {ex.Message}";
            cardSearchResults = [];
        }
        finally
        {
            isSearchingCards = false;
        }
    }

    private async Task AddSelectedMemberAsync()
    {
        if (selectedTeam is null || selectedCard is null)
            return;
        if (membershipEndDateInput.HasValue &&
            membershipEndDateInput.Value.Date < membershipStartDate.Date)
        {
            addMemberError = "Kadrodan ayrılma tarihi, katılım tarihinden önce olamaz.";
            return;
        }

        isAddingMember = true;
        addMemberError = null;

        try
        {
            var added = await Api.AddMembershipAsync(
                selectedTeam.Id,
                selectedCard.AtmacaCardId,
                membershipStartDate,
                membershipEndDateInput);

            if (!added)
            {
                addMemberError = "AtmacaCard kadroya eklenemedi.";
                return;
            }

            await LoadRosterAsync(selectedTeam.Id);
            CloseAddMember();
        }
        catch (Exception ex)
        {
            addMemberError = $"Üyelik oluşturulurken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isAddingMember = false;
        }
    }
    private async Task OpenMemberDetails(Member member)
    {
        selectedMember = member;
        assignmentError = null;
        showMembershipEndForm = false;
        membershipEndDate = DateOnly.FromDateTime(DateTime.Today);
        organizationDutyStartDate = DateTime.Today;
        organizationDutyAssignments = [];
        if (selectedTeam is null)
            return;

        isLoadingOrganizationDuties = true;
        try
        {
            organizationDutyAssignments = await Api.GetOrganizationDutyAssignmentsAsync(
                selectedTeam.OrganizationId,
                member.AtmacaCardId);
        }
        catch (Exception ex)
        {
            assignmentError = $"Kulüp görevleri yüklenemedi: {ex.Message}";
        }
        finally
        {
            isLoadingOrganizationDuties = false;
        }
    }

    private void OpenMembershipEndForm()
    {
        assignmentError = null;
        showMembershipEndForm = true;
        membershipEndDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private void CloseDetails()
    {
        selectedMember = null;
        showMembershipEndForm = false;
    }

    private async Task AddAssignmentAsync()
    {
        if (selectedTeam is null || selectedMember is null)
            return;

        var name = assignmentName.Trim();
        if (name.Length < 2)
        {
            assignmentError = "Atama adı en az 2 karakter olmalıdır.";
            return;
        }

        isAddingAssignment = true;
        assignmentError = null;

        try
        {
            if (assignmentScope == "Organization")
            {
                var organizationResult = await Api.AddOrganizationDutyAssignmentAsync(
                    selectedTeam.OrganizationId,
                    selectedMember.AtmacaCardId,
                    name,
                    organizationDutyStartDate.Date);
                if (!organizationResult.Succeeded)
                {
                    assignmentError = $"Kulüp görevi eklenemedi: {organizationResult.ErrorMessage}";
                    return;
                }

                organizationDutyAssignments = await Api.GetOrganizationDutyAssignmentsAsync(
                    selectedTeam.OrganizationId,
                    selectedMember.AtmacaCardId);
                assignmentName = string.Empty;
                return;
            }

            var result = await Api.AddMembershipAssignmentAsync(
                selectedTeam.Id,
                selectedMember.Id,
                assignmentKind,
                CreateDefinitionId(assignmentKind, name),
                name,
                DateTime.UtcNow);

            if (!result.Succeeded)
            {
                assignmentError = $"Atama oluşturulamadı: {result.ErrorMessage}";
                return;
            }

            await LoadRosterAsync(selectedTeam.Id);
            selectedMember = Members.FirstOrDefault(x => x.Id == selectedMember.Id);
            assignmentName = string.Empty;
        }
        catch (Exception ex)
        {
            assignmentError = $"Atama oluşturulurken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isAddingAssignment = false;
        }
    }

    private async Task EndOrganizationDutyAsync(OrganizationDutyAssignmentResponse duty)
    {
        if (selectedTeam is null || selectedMember is null)
            return;

        isAddingAssignment = true;
        assignmentError = null;
        try
        {
            var result = await Api.EndOrganizationDutyAssignmentAsync(
                selectedTeam.OrganizationId,
                selectedMember.AtmacaCardId,
                duty.Id,
                DateTime.Today);
            if (!result.Succeeded)
            {
                assignmentError = $"Kulüp görevi sonlandırılamadı: {result.ErrorMessage}";
                return;
            }

            organizationDutyAssignments = await Api.GetOrganizationDutyAssignmentsAsync(
                selectedTeam.OrganizationId,
                selectedMember.AtmacaCardId);
        }
        catch (Exception ex)
        {
            assignmentError = $"Kulüp görevi sonlandırılırken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isAddingAssignment = false;
        }
    }

    private async Task EndAssignmentAsync(Assignment assignment)
    {
        if (selectedTeam is null || selectedMember is null)
            return;

        assignmentError = null;
        try
        {
            var ended = await Api.EndMembershipAssignmentAsync(
                selectedTeam.Id,
                selectedMember.Id,
                assignment.Id,
                DateTime.UtcNow);

            if (!ended)
            {
                assignmentError = "Atama sonlandırılamadı.";
                return;
            }

            await LoadRosterAsync(selectedTeam.Id);
            selectedMember = Members.FirstOrDefault(x => x.Id == selectedMember.Id);
        }
        catch (Exception ex)
        {
            assignmentError = $"Atama sonlandırılırken bir sorun oluştu: {ex.Message}";
        }
    }

    private async Task EndMembershipAsync()
    {
        if (selectedTeam is null || selectedMember is null)
            return;

        isEndingMembership = true;
        assignmentError = null;
        var membershipId = selectedMember.Id;

        try
        {
            var ended = await Api.EndMembershipAsync(
                selectedTeam.Id,
                membershipId,
                membershipEndDate.ToDateTime(TimeOnly.MinValue));

            if (!ended)
            {
                assignmentError = "Üyelik sonlandırılamadı.";
                return;
            }

            await LoadRosterAsync(selectedTeam.Id);
            selectedMember = Members.FirstOrDefault(x => x.Id == membershipId);
            showMembershipEndForm = false;
        }
        catch (Exception ex)
        {
            assignmentError = $"Üyelik sonlandırılırken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isEndingMembership = false;
        }
    }

    private static Guid CreateDefinitionId(string kind, string name)
    {
        var bytes = System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(
                $"{kind.Trim().ToUpperInvariant()}:{name.Trim().ToUpperInvariant()}"));
        return new Guid(bytes[..16]);
    }

    private sealed record Member(Guid Id, string Name, string CardCode, string Initials, string AvatarColor, IReadOnlyList<string> Classifications, DateTime StartDate, string Period, bool IsActive, DateTime? EndDate, IReadOnlyList<Assignment> Assignments, Guid AtmacaCardId);
    private sealed record Assignment(Guid Id, string Kind, string Text, string Period, bool IsActive);

    private static string FormatOrganizationDutyPeriod(OrganizationDutyAssignmentResponse duty) =>
        duty.EndDate is null
            ? $"{duty.StartDate:dd.MM.yyyy} - devam ediyor"
            : $"{duty.StartDate:dd.MM.yyyy} - {duty.EndDate:dd.MM.yyyy}";

    private static string OrganizationDisplayName(CatalogItemResponse organization) =>
        organization.HierarchyPath ?? organization.Name;
}
