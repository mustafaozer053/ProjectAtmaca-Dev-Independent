@page "/scouting"
@rendermode InteractiveServer
@using ProjectAtmaca.Web.Services
@inject ScoutingApiClient ScoutingApi

<PageTitle>Scouting | ProjectAtmaca</PageTitle>

<div class="scout-page">
    <header><div><div class="eyebrow">SCOUTING</div><h1>Aday havuzu</h1>
        <p>Kulüp dışındaki potansiyel sporcuları gözlem kayıtlarıyla takip edin.</p></div>
        <button class="primary" @onclick="OpenForm" disabled="@loading">+ Aday ekle</button>
    </header>
    @if (error is not null) { <div class="error">@error</div> }
    @if (success is not null) { <div class="success">@success</div> }
    <div class="filters">
        <input placeholder="Aday ara..." @bind="search" @bind:event="oninput" />
        <select @bind="decisionFilter"><option value="0">Tüm durumlar</option>@foreach (var d in ScoutingLabels.Decisions) { <option value="@d.Value">@d.Label</option> }</select>
    </div>
    <section class="card">
        @if (loading) { <p class="empty">Adaylar yükleniyor...</p> }
        else if (Filtered.Count == 0) { <p class="empty">Aday bulunamadı.</p> }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>ADAY</th><th>DOĞUM</th><th>SON GÖZLEM</th><th>KULÜP</th><th>GÖZLEM</th><th>ORT. PUAN</th><th>DURUM</th></tr></thead><tbody>
            @foreach (var c in Filtered)
            {
                <tr><td><a href="@($"/scouting/{c.Id:D}")">@c.Name</a></td>
                    <td>@(c.BirthDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@(c.LastObservedOn?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(c.LastObservedClub) ? "—" : c.LastObservedClub)</td>
                    <td>@c.ObservationCount</td>
                    <td>@(c.AverageRating?.ToString("0.0") ?? "—")</td>
                    <td><span class="status d@(c.Decision)">@ScoutingLabels.Of(ScoutingLabels.Decisions, c.Decision)</span></td></tr>
            }
            </tbody></table></div>
        }
    </section>
</div>

@if (showForm)
{
    <div class="overlay" @onclick="CloseForm"><section class="panel" @onclick:stopPropagation>
        <button class="close" @onclick="CloseForm">×</button><h2>Aday ekle</h2>
        <label>Ad soyad<input maxlength="150" @bind="name" /></label>
        <div class="grid"><label>Doğum tarihi<input type="date" @bind="birthDate" /></label>
            <label>İlk tanışma kaynağı<select @bind="sourceType">@foreach (var s in ScoutingLabels.Sources) { <option value="@s.Value">@s.Label</option> }</select></label></div>
        @if (sourceType == 3) { <label>Tavsiye eden kişi<input maxlength="150" @bind="referrerName" /></label> }
        @if (sourceType == 7) { <label>Kaynak açıklaması<input maxlength="300" @bind="sourceDescription" /></label> }
        <div class="grid"><label>Kimlik türü<select @bind="identityType"><option value="0">Belirtilmedi</option>@foreach (var i in ScoutingLabels.IdentityTypes) { <option value="@i.Value">@i.Label</option> }</select></label>
            <label>Kimlik / pasaport no<input maxlength="30" @bind="identityNumber" disabled="@(identityType == 0)" /></label></div>
        @if (identityType > 1) { <label>Ülke kodu (ISO, ör. DE)<input maxlength="2" @bind="identityCountry" /></label> }
        <p class="hint">Kimlik no zorunlu değil; ancak adayı tanımaya yetecek en az bir bilgi (kimlik no, doğum tarihi, etkinlik/kulüp/takım) girilmelidir.</p>
        <div class="grid"><label>Telefon<input maxlength="20" @bind="phone" /></label><label>E-posta<input maxlength="200" @bind="email" /></label></div>
        <h3>İlk gözlem</h3>
        <ScoutingObservationFields Model="observation" />
        @if (formError is not null) { <div class="error">@formError</div> }
        <button class="primary full" @onclick="SaveAsync" disabled="@saving">@(saving ? "Kaydediliyor..." : "Adayı kaydet")</button>
    </section></div>
}

<style>
.scout-page{max-width:1200px;margin:0 auto;color:#19243a}.scout-page header{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1.5rem}.scout-page h1{margin:0}.scout-page header p,.empty{color:#8290a8}.eyebrow{color:#71809b;font-size:.72rem;font-weight:700;letter-spacing:.14em}.primary{border:0;border-radius:8px;padding:.7rem 1rem;background:#4058d6;color:white;font-weight:650;cursor:pointer}.filters{display:flex;gap:.7rem;margin-bottom:1rem}.filters input,.filters select{padding:.65rem;border:1px solid #e1e5ee;border-radius:7px}.filters input{flex:1}.card{background:white;border:1px solid #e8ebf2;border-radius:12px;overflow:hidden}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.9rem 1rem;border-bottom:1px solid #edf0f5}th{font-size:.68rem;color:#98a2b4;background:#fafbfc}.empty{text-align:center;padding:2.5rem}.overlay{position:fixed;inset:0;z-index:10;background:#17223a55;display:flex;justify-content:flex-end}.panel{width:min(520px,100%);height:100%;overflow:auto;background:white;padding:2rem;position:relative;box-sizing:border-box}.panel h2{margin-top:.3rem}.panel label{display:block;margin-top:1rem;color:#56647b;font-size:.78rem;font-weight:650}.panel input,.panel select,.panel textarea{display:block;width:100%;box-sizing:border-box;margin-top:.4rem;padding:.7rem;border:1px solid #e1e5ee;border-radius:7px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.full{width:100%;margin-top:1.4rem}.close{position:absolute;right:1rem;top:.8rem;border:0;background:none;font-size:1.6rem;color:#8994a8}.error,.success{margin:.8rem 0;padding:.8rem;border-radius:8px}.error{background:#fff1f1;color:#b45757}.success{background:#e7f7ee;color:#25804a}.status{padding:.3rem .55rem;border-radius:999px;background:#edf0ff;color:#4058d6;font-size:.72rem}.status.d2{background:#e7f7ee;color:#25804a}.status.d3{background:#fff0ef;color:#b94b45}
</style>

@code {
    private IReadOnlyList<ScoutingCandidateListResponse> candidates = [];
    private bool loading = true, showForm, saving;
    private string? error, success, formError;
    private string search = "", name = "", phone = "", email = "", referrerName = "", sourceDescription = "";
    private string identityNumber = "", identityCountry = "";
    private int decisionFilter, sourceType = 1, identityType;
    private DateOnly? birthDate;
    private ScoutingObservationModel observation = new();

    private IReadOnlyList<ScoutingCandidateListResponse> Filtered => candidates
        .Where(x => decisionFilter == 0 || x.Decision == decisionFilter)
        .Where(x => string.IsNullOrWhiteSpace(search) || x.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try { candidates = await ScoutingApi.ListAsync(); error = null; }
        catch (Exception ex) { error = ex.Message; }
        loading = false;
    }

    private void OpenForm()
    {
        name = phone = email = referrerName = sourceDescription = "";
        identityNumber = identityCountry = ""; identityType = 0;
        sourceType = 1; birthDate = null; formError = null; success = null;
        observation = new();
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(name)) { formError = "Ad soyad zorunludur."; return; }
        if (string.IsNullOrWhiteSpace(observation.ObserverName)) { formError = "Gözlemci adı zorunludur."; return; }
        saving = true; formError = null;
        try
        {
            await ScoutingApi.CreateAsync(new ScoutingCandidateRequest(
                name, birthDate, null, string.IsNullOrWhiteSpace(phone) ? null : phone, email, sourceType,
                string.IsNullOrWhiteSpace(referrerName) ? null : referrerName,
                string.IsNullOrWhiteSpace(sourceDescription) ? null : sourceDescription, observation.ToRequest(),
                identityType == 0 || string.IsNullOrWhiteSpace(identityNumber) ? null : identityType,
                identityType == 0 || string.IsNullOrWhiteSpace(identityNumber) ? null : identityNumber.Trim(),
                string.IsNullOrWhiteSpace(identityCountry) ? null : identityCountry.Trim().ToUpperInvariant()));
            showForm = false;
            success = "Aday havuza eklendi.";
            await LoadAsync();
        }
        catch (Exception ex) { formError = ex.Message; }
        saving = false;
    }
}
