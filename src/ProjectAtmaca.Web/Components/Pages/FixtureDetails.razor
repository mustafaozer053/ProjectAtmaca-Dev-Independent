</style>

@code {
    [Parameter] public Guid FixtureId { get; set; }

    private FixtureDetailsResponse? details;
    private SeasonTeamDetailsResponse? teamDetails;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? savedMessage;
    private string correctionReason = "";
    private int? durationMinutes;
    private string? referee;
    private string? matchNotes;
    private int ourGoalMinute = 1;
    private string ourGoalScorerId = "";
    private int opponentGoalMinute = 1;
    private int substitutionMinute = 1;
    private string outgoingPlayerId = "";
    private string incomingPlayerId = "";
    private int cardMinute = 1;
    private string cardPlayerId = "";
    private int cardType = 4;
    private List<FixtureSquadMemberInput> squad = [];
    private List<FixtureMatchEventInput> matchEvents = [];
    private List<FixtureScoreEventInput> scoreEvents = [];

    private bool IsReadOnly => details?.Fixture.Status is 2 or 3;
    private string TeamName => details is null
        ? "—"
        : teamDetails?.Name ?? "Takım";
    private int OurScore => scoreEvents
        .Where(x => x.Side == 1)
        .Sum(x => x.ScoreValue);
    private int OpponentScore => scoreEvents
        .Where(x => x.Side == 2)
        .Sum(x => x.ScoreValue);

    private List<SeasonTeamMembershipResponse> EligibleAthletes
    {
        get
        {
            if (details is null || teamDetails is null)
                return [];
            var date = details.Fixture.Date.ToDateTime(TimeOnly.MinValue).Date;
            return teamDetails.Memberships
                .Where(x => x.StartDate.Date <= date &&
                    (x.EndDate is null || x.EndDate.Value.Date >= date))
                .Where(x => x.Assignments.Any(a =>
                    string.Equals(a.Kind, "Classification", StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(a.DisplayNameSnapshot, "Sporcu", StringComparison.OrdinalIgnoreCase) &&
                    a.StartDate.Date <= date &&
                    (a.EndDate is null || a.EndDate.Value.Date >= date)))
                .OrderBy(x => x.AtmacaCardDisplayName)
                .ToList();
        }
    }

    private List<SeasonTeamMembershipResponse> SquadCandidates =>
        EligibleAthletes
            .Concat((teamDetails?.Memberships ?? [])
                .Where(x => squad.Any(member =>
                    member.AtmacaCardId == x.AtmacaCardId)))
            .DistinctBy(x => x.AtmacaCardId)
            .OrderBy(x => x.AtmacaCardDisplayName)
            .ToList();

    private List<SeasonTeamMembershipResponse> SelectedAthletes =>
        SquadCandidates.Where(x => SquadRole(x.AtmacaCardId) != "0").ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            details = await FixturesApi.GetDetailsAsync(FixtureId);
            if (details is null)
                throw new InvalidOperationException("Müsabaka kaydı bulunamadı.");
            teamDetails = await TeamsApi.GetSeasonTeamDetailsAsync(
                details.Fixture.SeasonTeamId);
            durationMinutes = details.DurationMinutes;
            referee = details.Referee;
            matchNotes = details.MatchNotes;
            squad = details.SquadMembers.ToList();
            matchEvents = details.MatchEvents.ToList();
            scoreEvents = details.ScoreEvents.ToList();
        }
        catch (Exception ex)
        {
            error = $"Müsabaka detayları yüklenemedi: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string SquadRole(Guid cardId) =>
        squad.FirstOrDefault(x => x.AtmacaCardId == cardId)?.Role.ToString() ?? "0";

    private void SetSquadRole(Guid cardId, string? roleText)
    {
        if (!int.TryParse(roleText, out var role))
            return;
        if (matchEvents.Any(x => x.Type == 3 &&
                ((x.AtmacaCardId == cardId && role != 1) ||
                 (x.RelatedAtmacaCardId == cardId && role != 2))))
        {
            error = "Oyuncu değişikliği kaydı bu sporcunun ilk onbir/yedek durumuna bağlı; önce değişiklik kaydını kaldırın.";
            return;
        }
        if (role == 0 &&
            (matchEvents.Any(x =>
                 x.AtmacaCardId == cardId ||
                 x.RelatedAtmacaCardId == cardId) ||
             scoreEvents.Any(x => x.AtmacaCardId == cardId)))
        {
            error = "Bu sporcu skor, değişiklik veya kart kaydıyla ilişkili; önce ilgili olayı kaldırın.";
            return;
        }
        error = null;
        squad.RemoveAll(x => x.AtmacaCardId == cardId);
        if (role is 1 or 2)
            squad.Add(new FixtureSquadMemberInput(cardId, role));
    }

    private IEnumerable<FixtureMatchEventInput> EventsOf(int type) =>
        matchEvents.Where(x => x.Type == type).OrderBy(x => x.Minute);

    private IEnumerable<FixtureScoreEventInput> ScoreEventsOf(int side) =>
        scoreEvents.Where(x => x.Side == side).OrderBy(x => x.Minute);

    private void AddGoal(int type)
    {
        var minute = type == 1 ? ourGoalMinute : opponentGoalMinute;
        if (minute is < 1 or > 180 ||
            (type == 1 && !Guid.TryParse(ourGoalScorerId, out _)))
        {
            error = type == 1
                ? "Gol dakikasını ve golü atan sporcuyu seçin."
                : "Gol dakikası 1 ile 180 arasında olmalıdır.";
            return;
        }
        error = null;
        Guid? scorerId = type == 1 && Guid.TryParse(ourGoalScorerId, out var parsedId)
            ? parsedId
            : null;
        scoreEvents.Add(new FixtureScoreEventInput(
            type,
            "FOOTBALL_GOAL",
            1,
            minute,
            scorerId));
    }

    private void AddSubstitution()
    {
        if (substitutionMinute is < 1 or > 180 ||
            !Guid.TryParse(outgoingPlayerId, out var outgoingId) ||
            !Guid.TryParse(incomingPlayerId, out var incomingId) ||
            outgoingId == incomingId ||
            SquadRole(outgoingId) != "1" ||
            SquadRole(incomingId) != "2")
        {
            error = "Dakikayı, ilk onbirden çıkan oyuncuyu ve yedeklerden giren oyuncuyu seçin.";
            return;
        }
        error = null;
        matchEvents.Add(new FixtureMatchEventInput(
            3, substitutionMinute, outgoingId, incomingId));
    }

    private void AddCard()
    {
        if (!Guid.TryParse(cardPlayerId, out var playerId) ||
            cardMinute is < 1 or > 180)
        {
            error = "Kart dakikasını ve sporcuyu kontrol edin.";
            return;
        }
        error = null;
        matchEvents.Add(new FixtureMatchEventInput(cardType, cardMinute, playerId, null));
    }

    private void RemoveEvent(FixtureMatchEventInput item) => matchEvents.Remove(item);
    private void RemoveScoreEvent(FixtureScoreEventInput item) => scoreEvents.Remove(item);

    private void SetScoreScorer(
        FixtureScoreEventInput item,
        string? cardIdText)
    {
        var index = scoreEvents.FindIndex(x => ReferenceEquals(x, item));
        if (index < 0)
            return;

        Guid? cardId = null;
        if (!string.IsNullOrWhiteSpace(cardIdText))
        {
            if (!Guid.TryParse(cardIdText, out var parsed) ||
                !SelectedAthletes.Any(x => x.AtmacaCardId == parsed))
            {
                error = "Golcü olarak kadrodaki bir sporcuyu seçin.";
                return;
            }
            cardId = parsed;
        }

        error = null;
        scoreEvents[index] = item with
        {
            AtmacaCardId = cardId,
            AssistAtmacaCardId = cardId is not null && cardId == item.AssistAtmacaCardId
                ? null
                : item.AssistAtmacaCardId
        };
    }

    private void SetScoreAssist(FixtureScoreEventInput item, string? cardIdText)
    {
        var index = scoreEvents.FindIndex(x => ReferenceEquals(x, item));
        if (index < 0)
            return;

        Guid? cardId = null;
        if (!string.IsNullOrWhiteSpace(cardIdText))
        {
            if (!Guid.TryParse(cardIdText, out var parsed) ||
                !SelectedAthletes.Any(x => x.AtmacaCardId == parsed) ||
                parsed == item.AtmacaCardId)
            {
                error = "Asist yapan olarak golcüden farklı, kadrodaki bir sporcuyu seçin.";
                return;
            }
            cardId = parsed;
        }

        error = null;
        scoreEvents[index] = item with { AssistAtmacaCardId = cardId };
    }

    private string PlayerName(Guid? cardId) =>
        teamDetails?.Memberships.FirstOrDefault(x => x.AtmacaCardId == cardId)
            ?.AtmacaCardDisplayName ?? "Bilinmeyen sporcu";

    private async Task SaveAsync() => await PersistDetailsAsync();

    private async Task<bool> PersistDetailsAsync()
    {
        if (durationMinutes is null or < 1 or > 180)
        {
            error = "Müsabaka süresi 1 ile 180 dakika arasında olmalıdır.";
            return false;
        }
        if (teamDetails is null)
        {
            error = "Takım kadrosu yüklenemedi.";
            return false;
        }
        saving = true;
        error = null;
        savedMessage = null;
        try
        {
            await FixturesApi.UpdateMatchDetailsAsync(
                FixtureId, durationMinutes.Value, referee, matchNotes,
                squad, matchEvents, scoreEvents);
            details = await FixturesApi.GetDetailsAsync(FixtureId);
            if (details is not null)
                scoreEvents = details.ScoreEvents.ToList();
            savedMessage = "Müsabaka detayları kaydedildi.";
            return true;
        }
        catch (Exception ex)
        {
            error = $"Müsabaka detayları kaydedilemedi: {ex.Message}";
            return false;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (!await PersistDetailsAsync())
            return;

        saving = true;
        error = null;
        savedMessage = null;
        try
        {
            await FixturesApi.CompleteAsync(FixtureId);
            await LoadAsync();
            savedMessage = "Müsabaka tamamlandı olarak kaydedildi ve sezon raporuna eklendi.";
        }
        catch (Exception ex)
        {
            error = $"Müsabaka tamamlandı olarak işaretlenemedi: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ReopenForCorrectionAsync()
    {
        if (string.IsNullOrWhiteSpace(correctionReason))
        {
            error = "Düzeltme nedenini yazın.";
            return;
        }

        saving = true;
        error = null;
        savedMessage = null;
        try
        {
            await FixturesApi.ReopenForCorrectionAsync(
                FixtureId, correctionReason.Trim());
            correctionReason = "";
            await LoadAsync();
            savedMessage = "Müsabaka düzeltme için yeniden açıldı. Kaydı düzelttikten sonra tekrar tamamlandı olarak işaretleyin.";
        }
        catch (Exception ex)
        {
            error = $"Müsabaka düzeltme için yeniden açılamadı: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }
}
