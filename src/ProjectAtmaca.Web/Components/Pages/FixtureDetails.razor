@page "/fixtures/{FixtureId:guid}"
@rendermode InteractiveServer
@using ProjectAtmaca.Web.Services
@inject FixturesApiClient FixturesApi
@inject SeasonTeamsApiClient TeamsApi
@inject NavigationManager Navigation

<PageTitle>Müsabaka detayı | ProjectAtmaca</PageTitle>

<main class="fixture-detail">
    <a class="back" href="/fixtures">← Müsabakalara dön</a>
    @if (loading)
    {
        <p class="state">Müsabaka bilgileri yükleniyor...</p>
    }
    else if (error is not null)
    {
        <div class="error">@error</div>
        <button class="secondary" @onclick="LoadAsync">Tekrar dene</button>
    }
    else if (details is not null)
    {
        <header class="heading">
            <div>
                <div class="eyebrow">MÜSABAKA DETAYI</div>
                <h1>@details.Fixture.Opponent</h1>
                <p>@TeamName · @details.Fixture.Date.ToString("dd.MM.yyyy") · @details.Fixture.StartTime.ToString("HH:mm") · @details.Fixture.Venue</p>
                <span class="status @(details.Fixture.Status == 2 ? "cancelled" : details.Fixture.Status == 3 ? "completed" : details.Fixture.Status == 4 ? "correction" : "scheduled")">
                    @(details.Fixture.Status == 2 ? "İptal edildi · salt okunur"
                        : details.Fixture.Status == 3 ? "Tamamlandı · salt okunur"
                        : details.Fixture.Status == 4 ? "Düzeltme için açıldı · düzenlenebilir"
                        : "Planlandı · düzenlenebilir")
                </span>
                @if (!string.IsNullOrWhiteSpace(details.Fixture.Notes))
                {
                    <p class="hint">Planlama notu: @details.Fixture.Notes</p>
                }
            </div>
            <div class="score">@OurScore : @OpponentScore</div>
        </header>

        @if (savedMessage is not null) { <div class="success">@savedMessage</div> }
        @if (error is not null) { <div class="error">@error</div> }
        @if (teamDetails is null)
        {
            <div class="error">Takım kadrosu yüklenemedi; müsabaka kadrosu değiştirilemiyor.</div>
        }

        @if (details.Corrections.Count > 0)
        {
            <section class="card">
                <h2>Düzeltme geçmişi</h2>
                <ul class="event-lines">
                    @foreach (var correction in details.Corrections)
                    {
                        <li>@correction.ReopenedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @correction.Reason</li>
                    }
                </ul>
            </section>
        }

        <section class="card">
            <h2>Müsabaka bilgileri</h2>
            <div class="form-grid">
                <label>Müsabaka süresi (dakika)
                    <input type="number" min="1" max="180" @bind="durationMinutes" disabled="@IsReadOnly" />
                </label>
                <label>Hakem bilgisi
                    <input maxlength="200" @bind="referee" disabled="@IsReadOnly" />
                </label>
            </div>
            <label>Açıklama notu
                <textarea maxlength="2000" rows="3" @bind="matchNotes" disabled="@IsReadOnly"></textarea>
            </label>
        </section>

        <section class="card">
            <h2>Müsabaka kadrosu</h2>
            <p class="hint">Müsabaka tarihinde aktif olan ve Sporcu sınıflandırması bulunan takım üyelerini seçin.</p>
            @if (EligibleAthletes.Count == 0)
            {
                <p class="state">Bu tarih için uygun sporcu bulunamadı.</p>
            }
            else
            {
                <div class="roster">
                    @foreach (var athlete in SquadCandidates)
                    {
                        <label class="roster-row">
                            <span>@athlete.AtmacaCardDisplayName <small>@athlete.AtmacaCardNumber</small></span>
                            <select value="@SquadRole(athlete.AtmacaCardId)" disabled="@IsReadOnly"
                                    @onchange="e => SetSquadRole(athlete.AtmacaCardId, e.Value?.ToString())">
                                <option value="0">Kadrodışı</option>
                                <option value="1">İlk onbir</option>
                                <option value="2">Yedek</option>
                            </select>
                        </label>
                    }
                </div>
            }
        </section>

        <section class="card">
            <h2>Gol dakikaları</h2>
            <p class="score-summary">Skor, kaydedilen gol dakikalarından otomatik hesaplanır: @OurScore : @OpponentScore</p>
            <div class="event-entry">
                <label>Bizim gol dakikası<input type="number" min="1" max="180" @bind="ourGoalMinute" disabled="@IsReadOnly" /></label>
                <label>Golü atan sporcu<select @bind="ourGoalScorerId" disabled="@IsReadOnly"><option value="">Sporcu seçin</option>@foreach (var player in SelectedAthletes) { <option value="@player.AtmacaCardId">@player.AtmacaCardDisplayName</option> }</select></label>
                <button class="secondary" @onclick="() => AddGoal(1)" disabled="@IsReadOnly">Gol ekle</button>
                <label>Rakip gol dakikası<input type="number" min="1" max="180" @bind="opponentGoalMinute" disabled="@IsReadOnly" /></label>
                <button class="secondary" @onclick="() => AddGoal(2)" disabled="@IsReadOnly">Gol ekle</button>
            </div>
            <div class="event-list">
                @foreach (var item in ScoreEventsOf(1))
                {
                    <span>Bizim takım · @item.Minute'</span>
                    <select value="@(item.AtmacaCardId?.ToString() ?? "")"
                            @onchange="e => SetScoreScorer(item, e.Value?.ToString())"
                            disabled="@IsReadOnly">
                        <option value="">Golcü belirtilmedi</option>
                        @foreach (var player in SelectedAthletes)
                        {
                            <option value="@player.AtmacaCardId">@player.AtmacaCardDisplayName</option>
                        }
                    </select>
                    <select value="@(item.AssistAtmacaCardId?.ToString() ?? "")"
                            @onchange="e => SetScoreAssist(item, e.Value?.ToString())"
                            disabled="@IsReadOnly">
                        <option value="">Asist yok</option>
                        @foreach (var player in SelectedAthletes.Where(x => x.AtmacaCardId != item.AtmacaCardId))
                        {
                            <option value="@player.AtmacaCardId">@player.AtmacaCardDisplayName</option>
                        }
                    </select>
                    <button @onclick="() => RemoveScoreEvent(item)" disabled="@IsReadOnly">×</button>
                }
                @foreach (var item in ScoreEventsOf(2))
                {
                    <span>Rakip · @item.Minute'</span><button @onclick="() => RemoveScoreEvent(item)" disabled="@IsReadOnly">×</button>
                }
            </div>
        </section>

        <section class="card">
            <h2>Oyuncu değişiklikleri</h2>
            <div class="event-entry substitution-entry">
                <label>Dakika<input type="number" min="1" max="180" @bind="substitutionMinute" disabled="@IsReadOnly" /></label>
                <label>Çıkan oyuncu<select @bind="outgoingPlayerId" disabled="@IsReadOnly"><option value="">İlk onbirden oyuncu seçin</option>@foreach (var player in SelectedAthletes.Where(x => SquadRole(x.AtmacaCardId) == "1")) { <option value="@player.AtmacaCardId">@player.AtmacaCardDisplayName</option> }</select></label>
                <label>Giren oyuncu<select @bind="incomingPlayerId" disabled="@IsReadOnly"><option value="">Yedeklerden oyuncu seçin</option>@foreach (var player in SelectedAthletes.Where(x => SquadRole(x.AtmacaCardId) == "2")) { <option value="@player.AtmacaCardId">@player.AtmacaCardDisplayName</option> }</select></label>
                <button class="secondary" @onclick="AddSubstitution" disabled="@IsReadOnly">Değişiklik ekle</button>
            </div>
            <ul class="event-lines">
                @foreach (var item in EventsOf(3))
                {
                    <li>@item.Minute' · @PlayerName(item.AtmacaCardId) çıktı, @PlayerName(item.RelatedAtmacaCardId) girdi <button @onclick="() => RemoveEvent(item)" disabled="@IsReadOnly">Kaldır</button></li>
                }
            </ul>
        </section>

        <section class="card">
            <h2>Kartlar</h2>
            <div class="event-entry card-entry">
                <label>Dakika<input type="number" min="1" max="180" @bind="cardMinute" disabled="@IsReadOnly" /></label>
                <label>Sporcu<select @bind="cardPlayerId" disabled="@IsReadOnly"><option value="">Oyuncu seçin</option>@foreach (var player in SelectedAthletes) { <option value="@player.AtmacaCardId">@player.AtmacaCardDisplayName</option> }</select></label>
                <label>Kart<select @bind="cardType" disabled="@IsReadOnly"><option value="4">Sarı</option><option value="5">Kırmızı</option></select></label>
                <button class="secondary" @onclick="AddCard" disabled="@IsReadOnly">Kart ekle</button>
            </div>
            <ul class="event-lines">
                @foreach (var item in EventsOf(4).Concat(EventsOf(5)).OrderBy(x => x.Minute))
                {
                    <li>@item.Minute' · @PlayerName(item.AtmacaCardId) · @(item.Type == 4 ? "Sarı kart" : "Kırmızı kart") <button @onclick="() => RemoveEvent(item)" disabled="@IsReadOnly">Kaldır</button></li>
                }
            </ul>
        </section>

        @if (IsReadOnly)
        {
            <p class="hint">
                @(details.Fixture.Status == 3
                    ? "Tamamlanmış müsabakanın bilgileri görüntülenebilir ancak düzenlenemez."
                    : "İptal edilmiş müsabakanın bilgileri görüntülenebilir ancak düzenlenemez.")
            </p>
            @if (details.Fixture.Status == 3)
            {
                @if (details.PlayerStatistics.Count > 0)
        {
            <section class="card">
                <h2>Oyuncu istatistikleri</h2>
                <p class="muted">Oynama süreleri kayıtlı müsabaka süresi (@(details.DurationMinutes?.ToString() ?? "belirtilmedi") dk), değişiklik ve kırmızı kart dakikalarına göre hesaplanır; son kaydedilen veriyi yansıtır.</p>
                <table>
                    <thead><tr><th>Sporcu</th><th>Rol</th><th>Süre (dk)</th><th>Gol</th><th>Asist</th><th>Sarı</th><th>Kırmızı</th></tr></thead>
                    <tbody>
                        @foreach (var stat in details.PlayerStatistics.OrderBy(x => x.Role).ThenByDescending(x => x.MinutesPlayed))
                        {
                            <tr><td>@PlayerName(stat.AtmacaCardId)</td><td>@(stat.Started ? "İlk 11" : "Yedek")</td><td>@stat.MinutesPlayed</td><td>@stat.Goals</td><td>@stat.Assists</td><td>@stat.YellowCards</td><td>@stat.RedCards</td></tr>
                        }
                    </tbody>
                </table>
            </section>
        }
        <section class="card correction-card">
                    <h2>Hatalı müsabaka verisini düzelt</h2>
                    <p class="hint">Aynı müsabaka kaydı yeniden açılır. Düzeltme tamamlanana kadar sezon raporunda yer almaz; yeniden tamamlandığında rapora güncel verilerle eklenir.</p>
                    <label>Düzeltme nedeni
                        <textarea maxlength="250" rows="2" @bind="correctionReason"></textarea>
                    </label>
                    <button class="complete" @onclick="ReopenForCorrectionAsync" disabled="@saving">
                        Düzeltme için yeniden aç
                    </button>
                </section>
            }
        }
        else
        {
            <button class="primary" @onclick="SaveAsync" disabled="@(saving || teamDetails is null)">
                @(saving ? "Kaydediliyor..." : "Müsabaka detaylarını kaydet")
            </button>
            @if (details.Fixture.Status is 1 or 4)
            {
                <button class="complete" @onclick="CompleteAsync" disabled="@(saving || durationMinutes is null || teamDetails is null)">
                    @(details.Fixture.Status == 4 ? "Kaydet ve düzeltilmiş verilerle tamamla" : "Kaydet ve müsabakayı tamamla")
                </button>
                <p class="hint">@(details.Fixture.Status == 4
                    ? "Düzeltme tamamlandığında müsabaka sezon raporuna güncel verilerle eklenir."
                    : "Tamamlama, ekrandaki tüm değişiklikleri önce kaydeder. Tamamlanan müsabakalar sezon raporuna eklenir ve daha sonra düzenlenemez.")</p>
            }
        }
    }
</main>

<style>
