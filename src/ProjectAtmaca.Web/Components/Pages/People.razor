@page "/people"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using ProjectAtmaca.Web.Services
@inject PeopleApiClient Api
@inject SeasonTeamsApiClient AssignmentApi
@inject IJSRuntime JS

<PageTitle>Kişiler | ProjectAtmaca</PageTitle>

<div class="people-page">
    <div class="people-header">
        <div>
            <div class="eyebrow">PERSONEL VE SPORCU DİZİNİ</div>
            <h1>Kişiler</h1>
            <p class="muted">Kayıtlı kişileri AtmacaCard numarası veya adlarına göre görüntüleyin.</p>
        </div>
        <a class="btn btn-primary" href="people/register">+ Yeni kişi kaydı</a>
    </div>
    <section class="people-card">
        <div class="people-toolbar">
            <div><strong>@people.Count</strong> kayıt gösteriliyor</div>
            <div class="people-search">
                <input @bind="searchTerm" @bind:event="oninput" @onkeydown="OnSearchKeyDown" placeholder="Ad veya ATM-000003" aria-label="Kişi ara" />
                <button class="btn btn-light" @onclick="LoadAsync" disabled="@isLoading">Ara</button>
            </div>
        </div>
        @if (isLoading)
        {
            <div class="people-empty">Kişiler yükleniyor...</div>
        }

        else if (errorMessage is not null)
        {
            <div class="error-banner">@errorMessage</div>
        }
        else if (people.Count == 0)
        {
            <div class="people-empty">Gösterilecek kişi bulunamadı.</div>
        }
        else
        {
            <div class="people-table-wrap">
                <table class="people-table">
                    <thead><tr><th>KİŞİ</th><th>ATMACACARD</th><th>KART DURUMU</th><th>KİŞİ ID</th></tr></thead>
                    <tbody>
                        @foreach (var person in people)
                        {
                            <tr class="people-row" @onclick="() => OpenPersonAsync(person)">
                                <td><strong>@person.FullName</strong></td>
                                <td><span class="card-number">@person.CardNumber</span></td>
                                <td><span class="card-status @(person.IsActive ? "active" : "inactive")">@(person.IsActive ? "Aktif" : "Pasif")</span></td>
                                <td><small>@person.PersonId</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (selectedPerson is not null)
    {
        <div class="people-overlay" @onclick="CloseDetails">
            <aside class="people-detail" @onclick:stopPropagation>
                <button class="close-button" @onclick="CloseDetails">×</button>
                <div class="eyebrow">ATMACACARD DETAYI</div>
                <div class="card-photo-panel">
                    @if (photoDataUri is not null)
                    {
                        <img class="card-photo" src="@photoDataUri" alt="@selectedPerson.FullName fotoğrafı" />
                    }
                    else
                    {
                        <div class="card-photo-placeholder" aria-label="Fotoğraf eklenmemiş">
                            @Initials(selectedPerson.FullName)
                        </div>
                    }
                    <label class="btn btn-light photo-upload-button">
                        @(isUploadingPhoto ? "Yükleniyor..." : photoDataUri is null ? "Fotoğraf ekle" : "Fotoğrafı değiştir")
                        <InputFile @key="photoInputKey" OnChange="OnPhotoFileSelected" accept=".jpg,.jpeg,.png" disabled="@isUploadingPhoto" />
                    </label>
                    <small class="muted">JPEG veya PNG, en fazla 5 MB</small>
                    @if (photoError is not null)
                    {
                        <div class="error-banner">@photoError</div>
                    }
                </div>
                <h2>@selectedPerson.FullName</h2>
                <span class="card-number">@selectedPerson.CardNumber</span>
                <p class="muted">Kart durumu: <strong>@(selectedPerson.IsActive ? "Aktif" : "Pasif")</strong></p>
                <p class="muted">Kartı pasifleştirmek kişi kaydını, sezon üyeliğini veya geçmiş katılım kayıtlarını silmez.</p>
                <section class="sports-profile-section">
                    <h3>Mesleki ünvanlar</h3>
                    <p class="muted">Kişiye bağlıdır; kurum ve sezon görevlerinden bağımsızdır. Ünvan değişiklikleri tarihçede korunur.</p>
                    @if (professionalTitleError is not null)
                    {
                        <div class="error-banner professional-title-error">@professionalTitleError</div>
                    }
                    @if (isLoadingProfessionalTitles)
                    {
                        <p class="muted">Ünvan geçmişi yükleniyor...</p>
                    }
                    else if (professionalTitles.Count > 0)
                    {
                        <div class="document-list">
                            @foreach (var title in professionalTitles)
                            {
                                <div class="document-row professional-title-row">
                                    <div>
                                        <strong>@title.Title</strong>
                                        <span>@FormatDate(title.StartedOn) – @(title.EndedOn.HasValue ? FormatDate(title.EndedOn.Value) : "Devam ediyor")</span>
                                        @foreach (var evidenceDocumentId in title.EvidenceDocumentIds)
                                        {
                                            var linkedDocument = documents.SingleOrDefault(document => document.Id == evidenceDocumentId);
                                            if (linkedDocument is not null)
                                            {
                                                <small>Belge: @linkedDocument.Title (@linkedDocument.OriginalFileName)</small>
                                            }
                                        }
                                        @if (editingProfessionalTitleId == title.Id)
                                        {
                                            <div class="professional-title-edit-form">
                                                <label class="field">Ünvan
                                                    <input class="form-input" @bind="professionalTitleEditName" maxlength="150" />
                                                </label>
                                                <label class="field">Başlangıç tarihi
                                                    <input type="date" class="form-input" @bind="professionalTitleEditStartedOn" />
                                                </label>
                                                <div class="professional-title-edit-actions">
                                                    <button class="text-button professional-title-link-button" @onclick="() => SaveProfessionalTitleEditAsync(title)" disabled="@isSavingProfessionalTitle">Değişiklikleri kaydet</button>
                                                    <button class="text-button" @onclick="CancelProfessionalTitleEdit" disabled="@isSavingProfessionalTitle">Vazgeç</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="professional-title-actions">
                                        @if (documents.Any(document => !title.EvidenceDocumentIds.Contains(document.Id)))
                                        {
                                            <select class="form-input"
                                                    value="@GetSelectedEvidenceDocumentId(title.Id)"
                                                    @onchange="args => SetSelectedEvidenceDocumentId(title.Id, args)">
                                                <option value="">Belge seçin</option>
                                                @foreach (var document in documents.Where(document => !title.EvidenceDocumentIds.Contains(document.Id)))
                                                {
                                                    <option value="@document.Id">@document.Title — @document.OriginalFileName</option>
                                                }
                                            </select>
                                            <button class="text-button professional-title-link-button" @onclick="() => LinkDocumentToProfessionalTitleAsync(title)" disabled="@(isSavingProfessionalTitle || string.IsNullOrWhiteSpace(GetSelectedEvidenceDocumentId(title.Id)))">Belge bağla</button>
                                        }
                                        <button class="text-button professional-title-edit-button" @onclick="() => BeginProfessionalTitleEdit(title)" disabled="@(isSavingProfessionalTitle || title.EndedOn.HasValue)" title="@(title.EndedOn.HasValue ? "Geçmiş ünvanlar düzenlenemez." : "Ünvanı düzenle")">Düzenle</button>
                                        <button class="text-button professional-title-delete-button" @onclick="() => RemoveProfessionalTitleAsync(title)" disabled="@(isSavingProfessionalTitle || title.EndedOn.HasValue || title.EvidenceDocumentIds.Count > 0)" title="@(title.EndedOn.HasValue ? "Geçmiş ünvanlar silinemez." : title.EvidenceDocumentIds.Count > 0 ? "Belge bağlı olduğu için silinemez." : "Ünvanı sil")">Sil</button>
                                        @if (!title.EndedOn.HasValue)
                                        {
                                            <button class="text-button professional-title-end-button" @onclick="() => EndProfessionalTitleAsync(title)" disabled="@isSavingProfessionalTitle">Ünvanı sonlandır</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">Henüz mesleki ünvan kaydı yok.</p>
                    }
                    <div class="sports-profile-form">
                        <label class="field">Mesleki ünvan
                            <input class="form-input" @bind="professionalTitleInput" maxlength="150" placeholder="Kişinin profesyonel ünvanı" />
                        </label>
                        <label class="field">Başlangıç tarihi
                            <input type="date" class="form-input" @bind="professionalTitleStartedOn" />
                        </label>
                        <button class="btn btn-light full-width" @onclick="AddProfessionalTitleAsync" disabled="@isSavingProfessionalTitle">
                            @(isSavingProfessionalTitle ? "Kaydediliyor..." : "Ünvan ekle")
                        </button>
                    </div>
                </section>
                <section class="sports-profile-section">
                    <h3>Kurum görevleri</h3>
                    <p class="muted">Kurum görevi sezonlardan bağımsızdır. Takım görevleri ise Kadro ekranında ilgili sezon takımına atanır.</p>
                    @if (organizationDutyError is not null)
                    {
                        <div class="error-banner professional-title-error">@organizationDutyError</div>
                    }
                    @if (isLoadingOrganizations)
                    {
                        <p class="muted">Kurumlar yükleniyor...</p>
                    }
                    else if (organizations.Count == 0)
                    {
                        <p class="muted">Aktif kurum bulunamadı.</p>
                    }
                    else
                    {
                        <label class="field">Kurum
                            <select class="form-input" value="@selectedOrganizationId" @onchange="OnOrganizationDutyOrganizationChanged">
                                <option value="">Kurum seçin</option>
                                @foreach (var organization in organizations)
                                {
                                    <option value="@organization.Id">@OrganizationDisplayName(organization)</option>
                                }
                            </select>
                        </label>
                        @if (Guid.TryParse(selectedOrganizationId, out _))
                        {
                            @if (isLoadingOrganizationDuties)
                            {
                                <p class="muted">Kurum görevleri yükleniyor...</p>
                            }
                            else if (organizationDutyAssignments.Count == 0)
                            {
                                <p class="muted">Bu kişiye bu kurumda henüz görev atanmamış.</p>
                            }
                            <div class="document-list">
                                @foreach (var duty in organizationDutyAssignments)
                                {
                                    <div class="document-row">
                                        <div>
                                            <strong>@duty.Title</strong>
                                            <span>@FormatDate(DateOnly.FromDateTime(duty.StartDate)) – @(duty.EndDate.HasValue ? FormatDate(DateOnly.FromDateTime(duty.EndDate.Value)) : "Devam ediyor")</span>
                                        </div>
                                        @if (!duty.EndDate.HasValue && duty.StartDate.Date <= DateTime.Today)
                                        {
                                            <button class="btn btn-light" @onclick="() => EndOrganizationDutyAsync(duty)" disabled="@isSavingOrganizationDuty">Sonlandır</button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="sports-profile-form">
                                <label class="field">Görev adı
                                    <input class="form-input" @bind="organizationDutyTitle" list="organization-duty-title-suggestions" maxlength="150" placeholder="Görev adını yazın veya seçin" />
                                </label>
                                <label class="field">Başlangıç tarihi
                                    <input type="date" class="form-input" @bind="organizationDutyStartDate" />
                                </label>
                                <button class="btn btn-light full-width" @onclick="AddOrganizationDutyAsync" disabled="@isSavingOrganizationDuty">
                                    @(isSavingOrganizationDuty ? "Kaydediliyor..." : "Kurum görevini ekle")
                                </button>
                            </div>
                        }
                    }
                </section>
                @if (statusError is not null)
                {
                    <div class="error-banner">@statusError</div>
                }
                <section class="sports-profile-section">
                    <h3>Eğitim bilgileri</h3>
                    <div class="sports-profile-form">
                        <label class="field">Şu anda okula devam ediyor mu?
                            <select class="form-input" value="@schoolAttendanceSelection" @onchange="OnSchoolAttendanceChanged">
                                <option value="no">Hayır</option>
                                <option value="yes">Evet</option>
                            </select>
                        </label>
                        @if (schoolAttendanceSelection == "yes")
                        {
                            <label class="field">Okul
                                <input class="form-input" @bind="schoolName" maxlength="150" />
                            </label>
                            <label class="field">Sınıf
                                <input class="form-input" @bind="schoolGrade" placeholder="Ör. 8. sınıf" maxlength="50" />
                            </label>
                            <label class="field">Okul numarası
                                <input class="form-input" @bind="schoolNumber" maxlength="30" />
                            </label>
                        }
                        @if (educationError is not null)
                        {
                            <div class="error-banner">@educationError</div>
                        }
                        <button class="btn btn-light full-width" @onclick="SaveEducationAsync" disabled="@isSavingEducation">
                            @(isSavingEducation ? "Kaydediliyor..." : "Eğitim bilgilerini kaydet")
                        </button>
                    </div>
                </section>
                <section class="sports-profile-section">
                    <h3>Sertifika ve diploma belgeleri</h3>
                    <p class="muted">Dosyalar yapılandırılmış harici disk/NAS depolama alanında tutulur; veritabanında yalnızca belge bilgileri ve depolama anahtarı saklanır. PDF, JPEG veya PNG; en fazla 10 MB.</p>
                    @if (isLoadingDocuments)
                    {
                        <p class="muted">Belgeler yükleniyor...</p>
                    }
                    else if (documents.Count > 0)
                    {
                        <div class="document-list">
                            @foreach (var document in documents)
                            {
                                <div class="document-row">
                                    <div>
                                        <strong>@(document.DocumentType == 1 ? "Sertifika" : "Diploma"): @document.Title</strong>
                                        <span>@(document.Issuer ?? "Veren kurum belirtilmedi") · @FormatDate(document.IssuedOn)</span>
                                        <small>@document.OriginalFileName · @FormatFileSize(document.FileSizeBytes)</small>
                                    </div>
                                    <button class="text-button" @onclick="() => DownloadDocumentAsync(document)" disabled="@isDownloadingDocument">İndir</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">Henüz sertifika veya diploma eklenmemiş.</p>
                    }
                    <div class="sports-profile-form">
                        <label class="field">Belge türü
                            <select class="form-input" @bind="documentType">
                                <option value="1">Sertifika</option>
                                <option value="2">Diploma</option>
                            </select>
                        </label>
                        <label class="field">Belge adı
                            <input class="form-input" @bind="documentTitle" maxlength="150" placeholder="Ör. UEFA C Antrenörlük Sertifikası" />
                        </label>
                        <label class="field">Veren kurum
                            <input class="form-input" @bind="documentIssuer" maxlength="150" />
                        </label>
                        <label class="field">Veriliş tarihi
                            <input type="date" class="form-input" @bind="documentIssuedOn" />
                        </label>
                        <label class="field">Dosya
                            <InputFile @key="documentInputKey" class="form-input" OnChange="OnDocumentFileSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            @if (selectedDocumentFile is not null)
                            {
                                <span class="muted">@selectedDocumentFile.Name (@FormatFileSize(selectedDocumentFile.Size))</span>
                            }
                        </label>
                        @if (documentError is not null)
                        {
                            <div class="error-banner">@documentError</div>
                        }
                        <button class="btn btn-light full-width" @onclick="UploadDocumentAsync" disabled="@isUploadingDocument">
                            @(isUploadingDocument ? "Yükleniyor..." : "Belgeyi kaydet")
                        </button>
                    </div>
                </section>
                <section class="sports-profile-section">
                    <h3>Sporcu branş profilleri</h3>
                    <p class="muted">Branşa ait lisans ve sporcu bilgileri burada tutulur; sezon takımındaki görev ve rollerden ayrıdır.</p>
                    @if (isLoadingProfiles)
                    {
                        <p class="muted">Branş profilleri yükleniyor...</p>
                    }
                    else if (sportsProfiles.Count > 0)
                    {
                        @foreach (var profile in sportsProfiles)
                        {
                            <div class="sports-profile-summary">
                                <strong>@profile.SportName</strong>
                                <span>Mevkiler: @(profile.Positions.Count == 0 ? "Belirtilmedi" : string.Join(", ", profile.Positions.Select(position => position.Name)))</span>
                                <span>Lisans: @(profile.LicenseNumber ?? "Belirtilmedi")</span>
                                <span>Branşa başlama: @FormatDate(profile.StartedSportOn)</span>
                                <span>Kulübe tescil: @FormatDate(profile.ClubRegisteredOn)</span>
                                <span>Düzey: @CompetitionLevelName(profile.CompetitionLevel)</span>
                                <span>Milli sporcu: @NationalAthleteName(profile.IsNationalAthlete)</span>
                                <button class="text-button" @onclick="() => EditSportsProfileAsync(profile)">Bu bilgileri düzenle</button>
                            </div>
                        }
                    }
                    <div class="sports-profile-form">
                        <label class="field">Spor branşı
                            <input class="form-input" @bind="sportsProfileSportName" @bind:after="LoadPositionsAsync" placeholder="Ör. Futbol" maxlength="80" />
                        </label>
                        @if (sportsProfileSportName.Trim().Length >= 2)
                        {
                            <div class="position-picker">
                                <strong>Bu branşın mevkileri</strong>
                                @if (isLoadingPositions)
                                {
                                    <span class="muted">Mevkiler yükleniyor...</span>
                                }
                                else if (positions.Count == 0)
                                {
                                    <span class="muted">Bu branş için henüz mevki tanımlanmamış.</span>
                                }
                                @foreach (var position in positions)
                                {
                                    <div class="position-option">
                                        <label>
                                            <input type="checkbox" checked="@selectedPositionIds.Contains(position.Id)" disabled="@(!position.IsActive)" @onchange="args => TogglePosition(position.Id, args)" />
                                            <span>@position.Name (@position.Code)@(position.IsActive ? string.Empty : " — Pasif")</span>
                                        </label>
                                        <button type="button" class="text-button" @onclick="() => ChangePositionStatusAsync(position, !position.IsActive)">@(position.IsActive ? "Pasifleştir" : "Aktifleştir")</button>
                                    </div>
                                }
                                <div class="position-create-form">
                                    <input class="form-input" @bind="newPositionCode" placeholder="Mevki kodu" maxlength="30" aria-label="Yeni mevki kodu" />
                                    <input class="form-input" @bind="newPositionName" placeholder="Mevki adı" maxlength="100" aria-label="Yeni mevki adı" />
                                    <button type="button" class="btn btn-light" @onclick="CreatePositionAsync" disabled="@isSavingPosition">@(isSavingPosition ? "Ekleniyor..." : "Mevki ekle")</button>
                                </div>
                                @if (positionError is not null)
                                {
                                    <div class="error-banner">@positionError</div>
                                }
                            </div>
                        }
                        <label class="field">Lisans numarası
                            <input class="form-input" @bind="sportsProfileLicenseNumber" maxlength="100" />
                        </label>
                        <label class="field">Branşa başlama tarihi
                            <input type="date" class="form-input" @bind="sportsProfileStartedOn" />
                        </label>
                        <label class="field">Kulübe tescil tarihi
                            <input type="date" class="form-input" @bind="sportsProfileClubRegisteredOn" />
                        </label>
                        <label class="field">Amatör / profesyonel
                            <select class="form-input" @bind="sportsProfileCompetitionLevel">
                                <option value="">Belirtilmedi</option>
                                <option value="1">Amatör</option>
                                <option value="2">Profesyonel</option>
                            </select>
                        </label>
                        <label class="field">Milli sporcu durumu
                            <select class="form-input" @bind="sportsProfileNationalStatus">
                                <option value="">Bilinmiyor</option>
                                <option value="true">Evet</option>
                                <option value="false">Hayır</option>
                            </select>
                        </label>
                        @if (sportsProfileError is not null)
                        {
                            <div class="error-banner">@sportsProfileError</div>
                        }
                        <button class="btn btn-light full-width" @onclick="SaveSportsProfileAsync" disabled="@isSavingSportsProfile">
                            @(isSavingSportsProfile ? "Kaydediliyor..." : "Branş profilini kaydet")
                        </button>
                    </div>
                </section>
                <section class="sports-profile-section">
                    <h3>Boy-kilo ölçüm geçmişi</h3>
                    <p class="muted">Her ölçüm tarihçeye eklenir; önceki değerlerin üzerine yazılmaz.</p>
                    @if (isLoadingMeasurements)
                    {
                        <p class="muted">Ölçüm geçmişi yükleniyor...</p>
                    }
                    else if (measurements.Count > 0)
                    {
                        <div class="measurement-list">
                            @foreach (var measurement in measurements)
                            {
                                <div class="measurement-row">
                                    <strong>@FormatDate(measurement.MeasuredOn)</strong>
                                    <span>Boy: @FormatMeasurement(measurement.HeightCentimeters, "cm")</span>
                                    <span>Kilo: @FormatMeasurement(measurement.WeightKilograms, "kg")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">Henüz ölçüm kaydı yok.</p>
                    }
                    <div class="sports-profile-form">
                        <label class="field">Ölçüm tarihi
                            <span class="measurement-date-entry">
                                <input type="text" class="form-input" @bind="measurementDateInput" @bind:event="oninput" placeholder="gg.aa.yyyy" inputmode="numeric" />
                                <span class="measurement-calendar-picker">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg>
                                    <input type="date" value="@measurementCalendarDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="OnMeasurementCalendarDateChanged" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" aria-label="Takvimden tarih seç" />
                                </span>
                            </span>
                        </label>
                        <label class="field">Boy (cm)
                            <input type="number" class="form-input" @bind="measurementHeight" step="0.01" min="30" max="250" />
                        </label>
                        <label class="field">Kilo (kg)
                            <input type="number" class="form-input" @bind="measurementWeight" step="0.01" min="1" max="300" />
                        </label>
                        @if (measurementError is not null)
                        {
                            <div class="error-banner">@measurementError</div>
                        }
                        <button class="btn btn-light full-width" @onclick="RecordMeasurementAsync" disabled="@isRecordingMeasurement">
                            @(isRecordingMeasurement ? "Kaydediliyor..." : "Ölçümü geçmişe ekle")
                        </button>
                    </div>
                </section>
                <div class="detail-list">
                    <div><small>AtmacaCard ID</small><strong>@selectedPerson.AtmacaCardId</strong></div>
                    <div><small>Kişi ID</small><strong>@selectedPerson.PersonId</strong></div>
                </div>
                <button class="btn btn-primary full-width" @onclick="ChangeStatusAsync" disabled="@isChangingStatus">
                    @(isChangingStatus ? "Güncelleniyor..." : selectedPerson.IsActive ? "Kartı pasifleştir" : "Kartı aktifleştir")
                </button>
                <button class="btn btn-light full-width" @onclick="CloseDetails">Kapat</button>
            </aside>
        </div>
    }
</div>

<datalist id="organization-duty-title-suggestions">
    @foreach (var title in OrganizationDutyTitleSuggestions.Values)
    {
        <option value="@title"></option>
    }
</datalist>

<style>
    .people-page { max-width: 1200px; margin: 0 auto; color: #19243a; }
    .people-header { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; margin-bottom:2rem; }
    .people-header h1 { font-size:2rem; margin:0; }.eyebrow { color:#71809b; font-size:.72rem; font-weight:700; letter-spacing:.14em; margin-bottom:.65rem; }.muted { color:#8290a8; margin:.35rem 0 0; }
    .btn { border:0; border-radius:8px; padding:.7rem 1rem; font-weight:650; cursor:pointer; text-decoration:none; font-size:.88rem; }.btn-primary { background:#4058d6; color:white; }.btn-light { background:#f3f5fa; color:#46536b; }
