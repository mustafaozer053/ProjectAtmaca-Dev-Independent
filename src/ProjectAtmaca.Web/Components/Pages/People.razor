    @@media(max-width:700px) { .people-header,.people-toolbar { flex-direction:column; align-items:stretch; }.people-search input { width:100%; } }
</style>

@code {
    private IReadOnlyList<AtmacaCardSummary> people = [];
    private AtmacaCardSummary? selectedPerson;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isChangingStatus;
    private string? errorMessage;
    private string? statusError;
    private IReadOnlyList<AtmacaCardSportsProfileResponse> sportsProfiles = [];
    private bool isLoadingProfiles;
    private bool isSavingSportsProfile;
    private string sportsProfileSportName = string.Empty;
    private string? sportsProfileLicenseNumber;
    private DateOnly? sportsProfileStartedOn;
    private DateOnly? sportsProfileClubRegisteredOn;
    private int? sportsProfileCompetitionLevel;
    private string sportsProfileNationalStatus = string.Empty;
    private string? sportsProfileError;
    private IReadOnlyList<PositionCatalogItem> positions = [];
    private readonly HashSet<Guid> selectedPositionIds = [];
    private bool isLoadingPositions;
    private bool isSavingPosition;
    private string newPositionCode = string.Empty;
    private string newPositionName = string.Empty;
    private string? positionError;
    private IReadOnlyList<AtmacaCardMeasurementResponse> measurements = [];
    private bool isLoadingMeasurements;
    private bool isRecordingMeasurement;
    private string measurementDateInput = DateOnly.FromDateTime(DateTime.Today).ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
    private DateOnly measurementCalendarDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal? measurementHeight;
    private decimal? measurementWeight;
    private string? measurementError;
    private string schoolAttendanceSelection = "no";
    private string? schoolName;
    private string? schoolGrade;
    private string? schoolNumber;
    private bool isSavingEducation;
    private string? educationError;
    private IReadOnlyList<AtmacaCardDocumentResponse> documents = [];
    private bool isLoadingDocuments;
    private bool isUploadingDocument;
    private bool isDownloadingDocument;
    private int documentType = 1;
    private string documentTitle = string.Empty;
    private string? documentIssuer;
    private DateOnly? documentIssuedOn;
    private IBrowserFile? selectedDocumentFile;
    private Guid documentInputKey = Guid.NewGuid();
    private string? documentError;
    private string? photoDataUri;
    private bool isUploadingPhoto;
    private IBrowserFile? selectedPhotoFile;
    private Guid photoInputKey = Guid.NewGuid();
    private string? photoError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            people = await Api.ListAsync(searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = $"Kişiler yüklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeStatusAsync()
    {
        if (selectedPerson is null)
            return;

        isChangingStatus = true;
        statusError = null;
        try
        {
            await Api.ChangeCardStatusAsync(
                selectedPerson.AtmacaCardId,
                !selectedPerson.IsActive);
            var cardId = selectedPerson.AtmacaCardId;
            await LoadAsync();
            selectedPerson = people.FirstOrDefault(x => x.AtmacaCardId == cardId);
        }
        catch (Exception ex)
        {
            statusError = $"Kart durumu güncellenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isChangingStatus = false;
        }
    }

    private async Task OpenPersonAsync(AtmacaCardSummary person)
    {
        selectedPerson = person;
        statusError = null;
        professionalTitles = [];
        professionalTitleInput = string.Empty;
        professionalTitleStartedOn = DateOnly.FromDateTime(DateTime.Today);
        professionalTitleError = null;
        selectedEvidenceDocumentIds.Clear();
        editingProfessionalTitleId = null;
        sportsProfileError = null;
        sportsProfiles = [];
        measurements = [];
        schoolAttendanceSelection = "no";
        schoolName = null;
        schoolGrade = null;
        schoolNumber = null;
        educationError = null;
        documents = [];
        selectedDocumentFile = null;
        documentInputKey = Guid.NewGuid();
        documentError = null;
        photoDataUri = null;
        selectedPhotoFile = null;
        photoInputKey = Guid.NewGuid();
        photoError = null;
        isLoadingProfessionalTitles = true;
        isLoadingOrganizations = true;
        selectedOrganizationId = string.Empty;
        organizations = [];
        organizationDutyAssignments = [];
        organizationDutyTitle = string.Empty;
        organizationDutyStartDate = DateTime.Today;
        organizationDutyError = null;
        sportsProfileSportName = string.Empty;
        sportsProfileLicenseNumber = null;
        sportsProfileStartedOn = null;
        sportsProfileClubRegisteredOn = null;
        sportsProfileCompetitionLevel = null;
        sportsProfileNationalStatus = string.Empty;
        isLoadingProfiles = true;
        isLoadingMeasurements = true;
        try
        {
            sportsProfiles = await Api.GetSportsProfilesAsync(person.AtmacaCardId);
        }
        catch (Exception ex)
        {
            sportsProfileError = $"Branş profilleri yüklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isLoadingProfiles = false;
        }
        try
        {
            measurements = await Api.GetMeasurementsAsync(person.AtmacaCardId);
        }
        catch (Exception ex)
        {
            measurementError = $"Ölçüm geçmişi yüklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isLoadingMeasurements = false;
        }
        try
        {
            var education = await Api.GetEducationAsync(person.AtmacaCardId);
            schoolAttendanceSelection = education.IsCurrentlyStudying ? "yes" : "no";
            schoolName = education.SchoolName;
            schoolGrade = education.SchoolGrade;
            schoolNumber = education.SchoolNumber;
        }
        catch (Exception ex)
        {
            educationError = $"Eğitim bilgileri yüklenirken bir sorun oluştu: {ex.Message}";
        }
        isLoadingDocuments = true;
        try
        {
            documents = await Api.GetDocumentsAsync(person.AtmacaCardId);
        }
        catch (Exception ex)
        {
            documentError = $"Belgeler yüklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isLoadingDocuments = false;
        }
        try
        {
            photoDataUri = await Api.GetPhotoDataUriAsync(person.AtmacaCardId);
        }
        catch (Exception ex)
        {
            photoError = $"Kart fotoğrafı yüklenemedi: {ex.Message}";
        }
        try
        {
            professionalTitles = await Api.GetProfessionalTitlesAsync(person.PersonId);
        }
        catch (Exception ex)
        {
            professionalTitleError = $"Mesleki ünvanlar yüklenemedi: {ex.Message}";
        }
        finally
        {
            isLoadingProfessionalTitles = false;
        }
        try
        {
            organizations = await AssignmentApi.GetCatalogAsync("organizations");
        }
        catch (Exception ex)
        {
            organizationDutyError = $"Kurumlar yüklenemedi: {ex.Message}";
        }
        finally
        {
            isLoadingOrganizations = false;
        }
    }

    private async Task OnOrganizationDutyOrganizationChanged(ChangeEventArgs args)
    {
        selectedOrganizationId = args.Value?.ToString() ?? string.Empty;
        organizationDutyError = null;
        organizationDutyAssignments = [];
        if (Guid.TryParse(selectedOrganizationId, out _))
            await LoadOrganizationDutyAssignmentsAsync();
    }

    private async Task LoadOrganizationDutyAssignmentsAsync()
    {
        if (selectedPerson is null ||
            !Guid.TryParse(selectedOrganizationId, out var organizationId))
            return;

        isLoadingOrganizationDuties = true;
        try
        {
            organizationDutyAssignments = await AssignmentApi.GetOrganizationDutyAssignmentsAsync(
                organizationId,
                selectedPerson.AtmacaCardId);
        }
        catch (Exception ex)
        {
            organizationDutyError = $"Kurum görevleri yüklenemedi: {ex.Message}";
        }
        finally
        {
            isLoadingOrganizationDuties = false;
        }
    }

    private async Task AddOrganizationDutyAsync()
    {
        if (selectedPerson is null)
            return;
        if (!Guid.TryParse(selectedOrganizationId, out var organizationId))
        {
            organizationDutyError = "Önce kurum seçin.";
            return;
        }
        if (string.IsNullOrWhiteSpace(organizationDutyTitle))
        {
            organizationDutyError = "Görev adı gereklidir.";
            return;
        }

        isSavingOrganizationDuty = true;
        organizationDutyError = null;
        try
        {
            var result = await AssignmentApi.AddOrganizationDutyAssignmentAsync(
                organizationId,
                selectedPerson.AtmacaCardId,
                organizationDutyTitle.Trim(),
                organizationDutyStartDate.Date);
            if (!result.Succeeded)
            {
                organizationDutyError = $"Kurum görevi eklenemedi: {result.ErrorMessage}";
                return;
            }

            organizationDutyTitle = string.Empty;
            await LoadOrganizationDutyAssignmentsAsync();
        }
        catch (Exception ex)
        {
            organizationDutyError = $"Kurum görevi eklenemedi: {ex.Message}";
        }
        finally
        {
            isSavingOrganizationDuty = false;
        }
    }

    private async Task EndOrganizationDutyAsync(OrganizationDutyAssignmentResponse duty)
    {
        if (selectedPerson is null ||
            !Guid.TryParse(selectedOrganizationId, out var organizationId))
            return;

        isSavingOrganizationDuty = true;
        organizationDutyError = null;
        try
        {
            var result = await AssignmentApi.EndOrganizationDutyAssignmentAsync(
                organizationId,
                selectedPerson.AtmacaCardId,
                duty.Id,
                DateTime.Today);
            if (!result.Succeeded)
            {
                organizationDutyError = $"Kurum görevi sonlandırılamadı: {result.ErrorMessage}";
                return;
            }

            await LoadOrganizationDutyAssignmentsAsync();
        }
        catch (Exception ex)
        {
            organizationDutyError = $"Kurum görevi sonlandırılamadı: {ex.Message}";
        }
        finally
        {
            isSavingOrganizationDuty = false;
        }
    }

    private async Task AddProfessionalTitleAsync()
    {
        if (selectedPerson is null)
            return;
        if (string.IsNullOrWhiteSpace(professionalTitleInput))
        {
            professionalTitleError = "Mesleki ünvan alanı gereklidir.";
            return;
        }

        isSavingProfessionalTitle = true;
        professionalTitleError = null;
        try
        {
            await Api.AddProfessionalTitleAsync(
                selectedPerson.PersonId,
                professionalTitleInput.Trim(),
                professionalTitleStartedOn);
            professionalTitleInput = string.Empty;
            professionalTitles = await Api.GetProfessionalTitlesAsync(selectedPerson.PersonId);
        }
        catch (Exception ex)
        {
            professionalTitleError = $"Mesleki ünvan kaydedilemedi: {ex.Message}";
        }
        finally
        {
            isSavingProfessionalTitle = false;
        }
    }

    private async Task EndProfessionalTitleAsync(ProfessionalTitleResponse title)
    {
        if (selectedPerson is null)
            return;

        isSavingProfessionalTitle = true;
        professionalTitleError = null;
        try
        {
            await Api.EndProfessionalTitleAsync(
                selectedPerson.PersonId,
                title.Id,
                DateOnly.FromDateTime(DateTime.Today));
            professionalTitles = await Api.GetProfessionalTitlesAsync(selectedPerson.PersonId);
        }
        catch (Exception ex)
        {
            professionalTitleError = $"Mesleki ünvan sonlandırılamadı: {ex.Message}";
        }
        finally
        {
            isSavingProfessionalTitle = false;
        }
    }

    private void BeginProfessionalTitleEdit(ProfessionalTitleResponse title)
    {
        editingProfessionalTitleId = title.Id;
        professionalTitleEditName = title.Title;
        professionalTitleEditStartedOn = title.StartedOn;
        professionalTitleError = null;
    }

    private void CancelProfessionalTitleEdit()
    {
        editingProfessionalTitleId = null;
        professionalTitleError = null;
    }

    private async Task SaveProfessionalTitleEditAsync(ProfessionalTitleResponse title)
    {
        if (selectedPerson is null)
            return;
        if (string.IsNullOrWhiteSpace(professionalTitleEditName))
        {
            professionalTitleError = "Mesleki ünvan alanı gereklidir.";
            return;
        }

        isSavingProfessionalTitle = true;
        professionalTitleError = null;
        try
        {
            await Api.UpdateProfessionalTitleAsync(
                selectedPerson.PersonId,
                title.Id,
                professionalTitleEditName.Trim(),
                professionalTitleEditStartedOn);
            professionalTitles = await Api.GetProfessionalTitlesAsync(selectedPerson.PersonId);
            editingProfessionalTitleId = null;
        }
        catch (Exception ex)
        {
            professionalTitleError = $"Mesleki ünvan güncellenemedi: {ex.Message}";
        }
        finally
        {
            isSavingProfessionalTitle = false;
        }
    }

    private async Task RemoveProfessionalTitleAsync(ProfessionalTitleResponse title)
    {
        if (selectedPerson is null)
            return;
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"'{title.Title}' ünvanını silmek istiyor musunuz? Bu işlem yalnızca belge bağlanmamış aktif ünvanlar için kullanılabilir.");
        if (!confirmed)
            return;

        isSavingProfessionalTitle = true;
        professionalTitleError = null;
        try
        {
            await Api.RemoveProfessionalTitleAsync(selectedPerson.PersonId, title.Id);
            professionalTitles = await Api.GetProfessionalTitlesAsync(selectedPerson.PersonId);
            if (editingProfessionalTitleId == title.Id)
                editingProfessionalTitleId = null;
        }
        catch (Exception ex)
        {
            professionalTitleError = $"Mesleki ünvan silinemedi: {ex.Message}";
        }
        finally
        {
            isSavingProfessionalTitle = false;
        }
    }

    private async Task LinkDocumentToProfessionalTitleAsync(ProfessionalTitleResponse title)
    {
        if (selectedPerson is null)
            return;
        if (!Guid.TryParse(GetSelectedEvidenceDocumentId(title.Id), out var documentId))
        {
            professionalTitleError = "Ünvana bağlamak için bir belge seçin.";
            return;
        }

        isSavingProfessionalTitle = true;
        professionalTitleError = null;
        try
        {
            await Api.LinkProfessionalTitleDocumentAsync(
                selectedPerson.PersonId,
                title.Id,
                documentId);
            selectedEvidenceDocumentIds.Remove(title.Id);
            professionalTitles = await Api.GetProfessionalTitlesAsync(selectedPerson.PersonId);
        }
        catch (Exception ex)
        {
            professionalTitleError = $"Belge ünvana bağlanamadı: {ex.Message}";
        }
        finally
        {
            isSavingProfessionalTitle = false;
        }
    }

    private string GetSelectedEvidenceDocumentId(Guid titleId) =>
        selectedEvidenceDocumentIds.TryGetValue(titleId, out var documentId)
            ? documentId
            : string.Empty;

    private void SetSelectedEvidenceDocumentId(Guid titleId, ChangeEventArgs args)
    {
        selectedEvidenceDocumentIds[titleId] = args.Value?.ToString() ?? string.Empty;
    }

    private async Task OnPhotoFileSelected(InputFileChangeEventArgs args)
    {
        if (selectedPerson is null)
            return;

        selectedPhotoFile = args.File;
        isUploadingPhoto = true;
        photoError = null;
        try
        {
            await Api.SavePhotoAsync(selectedPerson.AtmacaCardId, selectedPhotoFile);
            try
            {
                photoDataUri = await Api.GetPhotoDataUriAsync(selectedPerson.AtmacaCardId);
                selectedPhotoFile = null;
                photoInputKey = Guid.NewGuid();
            }
            catch (Exception ex)
            {
                photoError = $"Fotoğraf kaydedildi ancak görüntülenemedi: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            photoError = $"Fotoğraf kaydedilemedi: {ex.Message}";
        }
        finally
        {
            isUploadingPhoto = false;
        }
    }

    private void OnDocumentFileSelected(InputFileChangeEventArgs args)
    {
        selectedDocumentFile = args.File;
        documentError = null;
    }

    private async Task UploadDocumentAsync()
    {
        if (selectedPerson is null)
            return;
        if (string.IsNullOrWhiteSpace(documentTitle))
        {
            documentError = "Belge adı gereklidir.";
            return;
        }
        if (selectedDocumentFile is null)
        {
            documentError = "Yüklenecek dosyayı seçin.";
            return;
        }

        isUploadingDocument = true;
        documentError = null;
        try
        {
            await Api.UploadDocumentAsync(
                selectedPerson.AtmacaCardId,
                new PeopleApiClient.DocumentInput(
                    documentType,
                    documentTitle.Trim(),
                    documentIssuer,
                    documentIssuedOn),
                selectedDocumentFile);
            documentType = 1;
            documentTitle = string.Empty;
            documentIssuer = null;
            documentIssuedOn = null;
            selectedDocumentFile = null;
            documentInputKey = Guid.NewGuid();
            try
            {
                documents = await Api.GetDocumentsAsync(selectedPerson.AtmacaCardId);
            }
            catch (Exception ex)
            {
                documentError = $"Belge kaydedildi ancak liste yenilenemedi: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            documentError = $"Belge kaydedilirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isUploadingDocument = false;
        }
    }

    private async Task DownloadDocumentAsync(AtmacaCardDocumentResponse document)
    {
        if (selectedPerson is null)
            return;

        isDownloadingDocument = true;
        documentError = null;
        try
        {
            var download = await Api.DownloadDocumentAsync(selectedPerson.AtmacaCardId, document.Id);
            await JS.InvokeVoidAsync(
                "projectAtmaca.downloadFile",
                download.FileName,
                download.ContentType,
                download.Content);
        }
        catch (Exception ex)
        {
            documentError = $"Belge indirilemedi: {ex.Message}";
        }
        finally
        {
            isDownloadingDocument = false;
        }
    }

    private void OnSchoolAttendanceChanged(ChangeEventArgs args)
    {
        schoolAttendanceSelection = args.Value?.ToString() == "yes" ? "yes" : "no";
    }

    private async Task SaveEducationAsync()
    {
        if (selectedPerson is null)
            return;

        bool isCurrentlyStudying = schoolAttendanceSelection == "yes";
        isSavingEducation = true;
        educationError = null;
        try
        {
            await Api.UpdateEducationAsync(
                selectedPerson.AtmacaCardId,
                new PeopleApiClient.EducationInput(
                    isCurrentlyStudying,
                    isCurrentlyStudying ? schoolName : null,
                    isCurrentlyStudying ? schoolGrade : null,
                    isCurrentlyStudying ? schoolNumber : null));
            if (!isCurrentlyStudying)
            {
                schoolName = null;
                schoolGrade = null;
                schoolNumber = null;
            }
        }
        catch (Exception ex)
        {
            educationError = $"Eğitim bilgileri kaydedilirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isSavingEducation = false;
        }
    }

    private async Task SaveSportsProfileAsync()
    {
        if (selectedPerson is null)
            return;

        string? sportName = sportsProfileSportName.Trim();
        if (sportName.Length is < 2 or > 80)
        {
            sportsProfileError = "Spor branşı 2 ile 80 karakter arasında olmalıdır.";
            return;
        }

        bool? isNationalAthlete = sportsProfileNationalStatus switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
        isSavingSportsProfile = true;
        sportsProfileError = null;
        try
        {
            await Api.UpsertSportsProfileAsync(
                selectedPerson.AtmacaCardId,
                new PeopleApiClient.SportsProfileInput(
                    sportName,
                    sportsProfileLicenseNumber,
                    sportsProfileStartedOn,
                    sportsProfileClubRegisteredOn,
                    sportsProfileCompetitionLevel,
                    isNationalAthlete,
                    selectedPositionIds.ToList()));
            sportsProfiles = await Api.GetSportsProfilesAsync(selectedPerson.AtmacaCardId);
            sportsProfileSportName = string.Empty;
            sportsProfileLicenseNumber = null;
            sportsProfileStartedOn = null;
            sportsProfileClubRegisteredOn = null;
            sportsProfileCompetitionLevel = null;
            sportsProfileNationalStatus = string.Empty;
            selectedPositionIds.Clear();
            positions = [];
        }
        catch (Exception ex)
        {
            sportsProfileError = $"Branş profili kaydedilirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isSavingSportsProfile = false;
        }
    }

    private async Task EditSportsProfileAsync(AtmacaCardSportsProfileResponse profile)
    {
        sportsProfileSportName = profile.SportName;
        sportsProfileLicenseNumber = profile.LicenseNumber;
        sportsProfileStartedOn = profile.StartedSportOn;
        sportsProfileClubRegisteredOn = profile.ClubRegisteredOn;
        sportsProfileCompetitionLevel = profile.CompetitionLevel;
        sportsProfileNationalStatus = profile.IsNationalAthlete switch
        {
            true => "true",
            false => "false",
            _ => string.Empty
        };
        selectedPositionIds.Clear();
        foreach (var position in profile.Positions)
            selectedPositionIds.Add(position.Id);
        await LoadPositionsAsync();
        sportsProfileError = null;
    }

    private async Task LoadPositionsAsync()
    {
        string sportName = sportsProfileSportName.Trim();
        positionError = null;
        if (sportName.Length is < 2 or > 80)
        {
            positions = [];
            return;
        }

        isLoadingPositions = true;
        try
        {
            positions = await Api.GetPositionsAsync(sportName);
            selectedPositionIds.IntersectWith(positions.Select(position => position.Id));
        }
        catch (Exception ex)
        {
            positions = [];
            positionError = $"Branş mevkileri yüklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isLoadingPositions = false;
        }
    }

    private void TogglePosition(Guid positionId, ChangeEventArgs args)
    {
        if (bool.TryParse(args.Value?.ToString(), out bool isSelected))
        {
            if (isSelected)
                selectedPositionIds.Add(positionId);
            else
                selectedPositionIds.Remove(positionId);
        }
    }

    private async Task CreatePositionAsync()
    {
        if (string.IsNullOrWhiteSpace(newPositionCode) || string.IsNullOrWhiteSpace(newPositionName))
        {
            positionError = "Mevki kodu ve adı gereklidir.";
            return;
        }

        isSavingPosition = true;
        positionError = null;
        try
        {
            await Api.CreatePositionAsync(new PeopleApiClient.CreatePositionInput(
                sportsProfileSportName.Trim(),
                newPositionCode,
                newPositionName));
            string createdCode = newPositionCode.Trim();
            newPositionCode = string.Empty;
            newPositionName = string.Empty;
            await LoadPositionsAsync();
            PositionCatalogItem? createdPosition = positions.SingleOrDefault(
                position => string.Equals(position.Code, createdCode, StringComparison.OrdinalIgnoreCase));
            if (createdPosition is not null)
                selectedPositionIds.Add(createdPosition.Id);
        }
        catch (Exception ex)
        {
            positionError = $"Mevki eklenirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isSavingPosition = false;
        }
    }

    private async Task ChangePositionStatusAsync(PositionCatalogItem position, bool isActive)
    {
        positionError = null;
        try
        {
            await Api.ChangePositionStatusAsync(position.Id, isActive);
            if (!isActive && !sportsProfiles.Any(profile =>
                    string.Equals(profile.SportName, sportsProfileSportName.Trim(), StringComparison.OrdinalIgnoreCase) &&
                    profile.Positions.Any(assigned => assigned.Id == position.Id)))
            {
                selectedPositionIds.Remove(position.Id);
            }
            await LoadPositionsAsync();
        }
        catch (Exception ex)
        {
            positionError = $"Mevki durumu değiştirilemedi: {ex.Message}";
        }
    }

    private async Task RecordMeasurementAsync()
    {
        if (selectedPerson is null)
            return;

        if (!DateOnly.TryParseExact(
                measurementDateInput,
                "dd.MM.yyyy",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var measurementDate))
        {
            measurementError = "Ölçüm tarihini gg.aa.yyyy biçiminde girin.";
            return;
        }

        if (measurementDate > DateOnly.FromDateTime(DateTime.Today))
        {
            measurementError = "Ölçüm tarihi gelecek bir gün olamaz.";
            return;
        }

        if (measurementHeight is null && measurementWeight is null)
        {
            measurementError = "En azından boy veya kilo değerinden birini girin.";
            return;
        }

        isRecordingMeasurement = true;
        measurementError = null;
        try
        {
            await Api.RecordMeasurementAsync(
                selectedPerson.AtmacaCardId,
                new PeopleApiClient.MeasurementInput(
                    measurementDate,
                    measurementHeight,
                    measurementWeight));
            measurements = await Api.GetMeasurementsAsync(selectedPerson.AtmacaCardId);
            measurementDate = DateOnly.FromDateTime(DateTime.Today);
            measurementDateInput = measurementDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
            measurementCalendarDate = measurementDate;
            measurementHeight = null;
            measurementWeight = null;
        }
        catch (Exception ex)
        {
            measurementError = $"Ölçüm kaydedilirken bir sorun oluştu: {ex.Message}";
        }
        finally
        {
            isRecordingMeasurement = false;
        }
    }

    private void OnMeasurementCalendarDateChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(
                args.Value?.ToString(),
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var selectedDate))
        {
            measurementCalendarDate = selectedDate;
            measurementDateInput = selectedDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
        }
    }

